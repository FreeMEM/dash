{
  "name": "dash-mui-editor",
  "displayName": "Dash for Amiga",
  "description": "Dash, a language for the Commodore Amiga and DashOS: highlighting, errors while typing, completion, Dash's help with its examples, compile and run in FS-UAE or in DashOS (QEMU), debugging on the emulated or a real Amiga, project templates, a visual editor for MUI windows, and sprite, BOB and tile map editors for games (as in Forja).",
  "version": "0.6.0",
  "publisher": "FreeMEM",
  "author": {
    "name": "Francisco Antonio Tapias Bravo",
    "url": "https://github.com/FreeMEM"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Snippets",
    "Formatters",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.dashui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "En una carpeta sin confianza (modo restringido) hay colores y editor visual; compilar y el emulador, solo en carpetas de confianza.",
      "restrictedConfigurations": [
        "dash.path",
        "dash.emulator.kickstart",
        "dash.emulator.system",
        "dash.emulator.muiSystem",
        "dash.python",
        "dash.emulator.kickstartA500",
        "dash.emulator.kickstart32",
        "dash.emulator.system32",
        "dash.emulator.systemRtg",
        "dash.debug.gdb",
        "dash.dashos.folder",
        "dash.dashos.kitC"
      ]
    }
  },
  "contributes": {
    "configurationDefaults": {
      "[dash]": {
        "files.autoGuessEncoding": true
      }
    },
    "languages": [
      {
        "id": "dash",
        "aliases": [
          "Dash",
          "dash"
        ],
        "extensions": [
          ".dash"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/dash-file.svg",
          "dark": "./media/dash-file.svg"
        }
      },
      {
        "id": "json",
        "extensions": [
          ".dashui"
        ]
      }
    ],
    "grammars": [
      {
        "language": "dash",
        "scopeName": "source.dash",
        "path": "./syntaxes/dash.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.c.dash": "c"
        }
      }
    ],
    "commands": [
      {
        "command": "dash.compile",
        "title": "Compilar",
        "category": "Dash",
        "icon": "$(tools)"
      },
      {
        "command": "dash.runInEmulator",
        "title": "Ejecutar en emulador",
        "category": "Dash",
        "icon": "$(play)"
      },
      {
        "command": "dash.newWindowFile",
        "title": "Nuevo fichero de ventanas MUI (.dashui)",
        "category": "Dash"
      },
      {
        "command": "dash.newGraphic",
        "title": "Nuevo sprite, BOB o mapa",
        "category": "Dash"
      },
      {
        "command": "dash.newline",
        "title": "Nueva línea (con end)",
        "category": "Dash"
      },
      {
        "command": "dash.restartLanguageServer",
        "title": "Reiniciar el servidor de lenguaje",
        "category": "Dash"
      },
      {
        "command": "dash.runMemcheck",
        "title": "Ejecutar con comprobación de memoria",
        "category": "Dash"
      },
      {
        "command": "dash.runProfile",
        "title": "Ejecutar con perfil",
        "category": "Dash"
      },
      {
        "command": "dash.chooseMachine",
        "title": "Elegir la máquina del emulador",
        "category": "Dash"
      },
      {
        "command": "dash.debug",
        "title": "Depurar en el Amiga",
        "category": "Dash",
        "icon": "$(debug-alt)"
      },
      {
        "command": "dash.prepareAmiga",
        "title": "Preparar para un Amiga real",
        "category": "Dash"
      },
      {
        "command": "dash.gotoEvent",
        "title": "Ir al código del evento",
        "category": "Dash"
      },
      {
        "command": "dash.newProject",
        "title": "Nuevo proyecto",
        "category": "Dash"
      },
      {
        "command": "dash.choosePath",
        "title": "Elegir la carpeta del compilador",
        "category": "Dash"
      },
      {
        "command": "dash.runInDashOS",
        "title": "Ejecutar en DashOS (QEMU)",
        "category": "Dash",
        "icon": "$(vm)"
      },
      {
        "command": "dash.compileDashOS",
        "title": "Compilar para DashOS",
        "category": "Dash"
      },
      {
        "command": "dash.help.show",
        "title": "Ayuda de Dash",
        "category": "Dash",
        "icon": "$(book)"
      },
      {
        "command": "dash.help.search",
        "title": "Buscar en la ayuda",
        "category": "Dash"
      },
      {
        "command": "dash.help.try",
        "title": "Probar el ejemplo de la ayuda",
        "category": "Dash"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "dash.runInEmulator",
          "when": "resourceLangId == dash",
          "group": "navigation@1"
        },
        {
          "command": "dash.debug",
          "when": "resourceLangId == dash",
          "group": "navigation@2"
        },
        {
          "command": "dash.runInDashOS",
          "when": "resourceLangId == dash",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "dash.newGraphic",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "dash.newline",
          "when": "false"
        },
        {
          "command": "dash.gotoEvent",
          "when": "false"
        },
        {
          "command": "dash.help.try",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "dash.help.show",
          "when": "editorLangId == dash",
          "group": "navigation@9"
        }
      ]
    },
    "configuration": {
      "title": "Dash",
      "properties": {
        "dash.path": {
          "type": "string",
          "default": "",
          "description": "Carpeta del compilador Dash (la que tiene el script ./dash). Vacío: se busca subiendo desde el fichero."
        },
        "dash.outputFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Carpeta donde se dejan los ejecutables al compilar: una ruta entera, `~/...` o relativa a la carpeta del `.dash`. Vacío: `bin/` al lado de cada `.dash`."
        },
        "dash.emulator.kickstart": {
          "type": "string",
          "default": "",
          "description": "ROM de Kickstart para FS-UAE (DASH_KICKSTART). Vacío: la variable de entorno o la ROM AROS."
        },
        "dash.emulator.system": {
          "type": "string",
          "default": "",
          "description": "Ficheros de Workbench para el emulador (DASH_EMU_SYS; para MUI, DASH_EMU_SYS_MUI)."
        },
        "dash.emulator.autoclose": {
          "type": "number",
          "default": 0,
          "description": "Segundos tras los que el programa se cierra solo en el emulador (0: no)."
        },
        "dash.emulator.muiSystem": {
          "type": "string",
          "default": "",
          "description": "Ficheros de Workbench con MUI para \"Ver en Amiga\" (DASH_EMU_SYS_MUI; se hacen con tools/emu_sys_mui.sh)."
        },
        "dash.editor.autoEnd": {
          "type": "boolean",
          "default": true,
          "description": "Al pulsar Enter tras una línea que abre un bloque (func, if, while, struct, Main...) se añade su end si aún no lo tiene."
        },
        "dash.updates.check": {
          "type": "boolean",
          "default": true,
          "description": "Una vez al día, mirar en GitHub si hay una versión nueva de Dash y avisar (la petición va a api.github.com)."
        },
        "dash.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "El servidor de lenguaje del compilador Dash (python3 -m compiler.lsp): autocompletado, ayuda de argumentos, ir a la definición, renombrar, formatear... y, con \"dash.errors.source\": \"languageServer\", los errores. Solo en carpetas de confianza."
        },
        "dash.python": {
          "type": "string",
          "default": "python3",
          "description": "El Python con el que corre el servidor de lenguaje (el mismo que usa ./dash; necesita lark)."
        },
        "dash.emulator.previewOnChange": {
          "type": "boolean",
          "default": false,
          "description": "Editor de ventanas: \"Ver en Amiga\" otra vez, solo, un momento después de cada cambio (la casilla \"al cambiar\" junto al botón)."
        },
        "dash.emulator.machine": {
          "type": "string",
          "default": "a1200",
          "enum": [
            "a1200",
            "a500",
            "a1200-32",
            "rtg"
          ],
          "enumDescriptions": [
            "A1200 con Kickstart 3.1 (dash.emulator.kickstart, dash.emulator.system)",
            "A500, 68000, Kickstart 3.1 (dash.emulator.kickstartA500)",
            "A1200 con AmigaOS 3.2 (dash.emulator.kickstart32, dash.emulator.system32)",
            "68040 con tarjeta gráfica (Picasso96), AmigaOS 3.2 (dash.emulator.systemRtg)"
          ],
          "description": "Máquina en la que se ejecutan los programas (también en la barra de estado). Se puede fijar por proyecto (.vscode/settings.json)."
        },
        "dash.emulator.program": {
          "type": "string",
          "default": "fs-uae",
          "enum": [
            "fs-uae",
            "amiberry"
          ],
          "description": "Emulador: FS-UAE o Amiberry (A1200 y A500; su bsdsocket da sucesos de sockets: net_signal)."
        },
        "dash.emulator.window": {
          "type": "boolean",
          "default": true,
          "description": "Ver la ventana del emulador (y oírlo). Sin ella corre oculto, como en los tests."
        },
        "dash.emulator.kickstartA500": {
          "type": "string",
          "default": "",
          "description": "ROM de Kickstart 3.1 de A500 (DASH_KICKSTART_A500)."
        },
        "dash.emulator.kickstart32": {
          "type": "string",
          "default": "",
          "description": "ROM de Kickstart 3.2 de A1200 (DASH_KICKSTART_32)."
        },
        "dash.emulator.system32": {
          "type": "string",
          "default": "",
          "description": "Ficheros de un Workbench 3.2 (DASH_EMU_SYS_32)."
        },
        "dash.emulator.systemRtg": {
          "type": "string",
          "default": "",
          "description": "Ficheros de un Workbench 3.2 con Picasso96 (DASH_EMU_SYS_32_RTG; tools/emu_sys_rtg.sh de dashweb)."
        },
        "dash.debug.gdb": {
          "type": "string",
          "default": "/opt/amiga/bin/m68k-amigaos-gdb",
          "description": "El gdb de m68k-amigaos (con Python: hace de adaptador de depuración, -i=dap)."
        },
        "dash.emulator.muiSystem32": {
          "type": "string",
          "default": "",
          "description": "Ficheros de Workbench 3.2 con MUI para \"Ver en Amiga\" en la máquina A1200 (3.2) (DASH_EMU_SYS_32_MUI; tools/emu_sys_mui.sh)."
        },
        "dash.errors.source": {
          "type": "string",
          "default": "check",
          "enum": [
            "check",
            "languageServer"
          ],
          "enumDescriptions": [
            "./dash --check: el compilador que hace el ejecutable (directo a 68000), hasta 20 errores, en unas centésimas; con el texto sin guardar de los .dash abiertos (--texto).",
            "El servidor de lenguaje (el analizador del camino por C, ./dash --gcc), como antes de la 0.6."
          ],
          "markdownDescription": "Quién marca los errores mientras se escribe. `check` (de serie): `./dash --check`, el mismo compilador que hace el ejecutable, con sus palabras. Si ese Dash no sabe `--check`, se usan los del servidor de lenguaje."
        },
        "dash.help.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "es",
            "en"
          ],
          "enumDescriptions": [
            "El de VS Code (castellano si es es-*, si no inglés)",
            "Castellano",
            "Inglés"
          ],
          "description": "Idioma de la ayuda de Dash (la vista de ayuda y lo que añade al pasar el ratón)."
        },
        "dash.dashos.folder": {
          "type": "string",
          "default": "",
          "markdownDescription": "La carpeta de DashOS (`DASHOS_DIR`): su `build/libkit_c.a` (`make -C kernel kit-c`) hace falta para los programas con ventanas (`mui_*`). Vacío: `~/Projects/dashos`."
        },
        "dash.dashos.kitC": {
          "type": "string",
          "default": "",
          "markdownDescription": "El fichero `libkit_c.a` de DashOS (`DASH_KIT_C`), si no está en la carpeta de `dash.dashos.folder`."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "dash.dashuiEditor",
        "displayName": "Editor de ventanas MUI",
        "selector": [
          {
            "filenamePattern": "*.dashui"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "dash.spriteEditor",
        "displayName": "Editor de sprites y BOBs",
        "selector": [
          {
            "filenamePattern": "*.iff"
          },
          {
            "filenamePattern": "*.ilbm"
          },
          {
            "filenamePattern": "*.lbm"
          },
          {
            "filenamePattern": "*.brush"
          },
          {
            "filenamePattern": "*.bob"
          },
          {
            "filenamePattern": "*.spr"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "dash.mapEditor",
        "displayName": "Editor de mapas de tiles",
        "selector": [
          {
            "filenamePattern": "*.fmap"
          }
        ],
        "priority": "default"
      }
    ],
    "snippets": [
      {
        "language": "dash",
        "path": "./snippets/dash.json"
      }
    ],
    "keybindings": [
      {
        "key": "enter",
        "command": "dash.newline",
        "when": "editorTextFocus && editorLangId == dash && !suggestWidgetVisible && !inSnippetMode && !editorHasMultipleSelections && !editorReadonly && !inlineSuggestionVisible"
      },
      {
        "key": "shift+f1",
        "command": "dash.help.show",
        "when": "editorTextFocus && editorLangId == dash"
      }
    ],
    "taskDefinitions": [
      {
        "type": "dash",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "compile",
              "run",
              "memcheck",
              "profile",
              "dashos",
              "dashos-run"
            ],
            "description": "compile, run (en el emulador), memcheck (con --memcheck), profile (con --profile), dashos (compilar para DashOS) o dashos-run (compilar para DashOS y ejecutar en QEMU)"
          },
          "file": {
            "type": "string",
            "description": "El .dash (por defecto el abierto: ${file})"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "dash",
        "owner": "dash",
        "source": "dash",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(Error|Warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      {
        "name": "dash-memcheck",
        "owner": "dash",
        "source": "dash --memcheck",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^memcheck: ERROR (.*) \\(en (.*):(\\d+)\\)$",
          "message": 1,
          "file": 2,
          "line": 3
        },
        "severity": "error"
      }
    ],
    "breakpoints": [
      {
        "language": "dash"
      }
    ],
    "debuggers": [
      {
        "type": "dash",
        "label": "Dash (Amiga)",
        "languages": [
          "dash"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "default": "${file}",
                "description": "El .dash que se depura (se compila con ./dash --debug)."
              },
              "args": {
                "type": "string",
                "default": "",
                "description": "Los argumentos del programa, como en el Shell (con el depurador de Dash 2.0)."
              },
              "debugger": {
                "type": "string",
                "enum": [
                  "dash",
                  "gdb"
                ],
                "enumDescriptions": [
                  "El de Dash 2.0: el programa compilado por el compilador propio de Dash (./dash), depurado en el Amiga por tools/amiga/dbgserver.dash.",
                  "El de Dash 1.x: el programa compilado por C con gcc (./dash --gcc), bajo bgdbserver y m68k-amigaos-gdb."
                ],
                "default": "dash",
                "description": "Con qué se depura. Un programa con C dentro va siempre con gdb."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false,
                "description": "Parar al empezar el programa."
              },
              "machine": {
                "type": "string",
                "enum": [
                  "a1200",
                  "a500",
                  "a1200-32",
                  "rtg"
                ],
                "description": "Máquina (por defecto dash.emulator.machine)."
              },
              "emulator": {
                "type": "string",
                "enum": [
                  "fs-uae",
                  "amiberry"
                ],
                "description": "Emulador (por defecto dash.emulator.program)."
              },
              "window": {
                "type": "boolean",
                "default": true,
                "description": "Ver la ventana del emulador."
              },
              "target": {
                "type": "string",
                "enum": [
                  "amiga",
                  "dashos"
                ],
                "default": "amiga",
                "enumDescriptions": [
                  "Depurar en el Amiga emulado",
                  "No depura: compila con ./dash --dashos y lo ejecuta en QEMU (qemu-aarch64, tools/dashos_run.py), con la salida en el panel"
                ],
                "description": "Dónde va el programa: el Amiga (depurar) o DashOS (ejecutar en QEMU)."
              },
              "compileOnly": {
                "type": "boolean",
                "default": false,
                "description": "Con \"target\": \"dashos\", solo compilar para DashOS (el ELF en bin/dashos/)."
              }
            }
          },
          "attach": {
            "required": [
              "target",
              "program"
            ],
            "properties": {
              "target": {
                "type": "string",
                "default": "amiga.local:2345",
                "description": "host:puerto de un bgdbserver ya en marcha (un Amiga real, por ejemplo)."
              },
              "program": {
                "type": "string",
                "description": "El ejecutable compilado con ./dash --gcc --debug (sus símbolos), o el .dash (entonces bin/<nombre>.debug, como lo deja \"Dash: Preparar para un Amiga real\")."
              },
              "relay": {
                "type": "boolean",
                "default": true,
                "description": "gdb pasa por tools/gdb_relay.py, que corrige dónde están las variables globales (false: directo a target)."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false,
                "description": "Parar al empezar el programa."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "dash",
            "request": "launch",
            "name": "Depurar en el Amiga",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Dash: depurar en el Amiga emulado",
            "description": "Compila con --debug y lo depura en FS-UAE o Amiberry",
            "body": {
              "type": "dash",
              "request": "launch",
              "name": "Depurar en el Amiga",
              "program": "^\"\\${file}\""
            }
          },
          {
            "label": "Dash: depurar en un Amiga real (bgdbserver)",
            "description": "Se conecta a bgdbserver por la red (antes: Dash: Preparar para un Amiga real)",
            "body": {
              "type": "dash",
              "request": "attach",
              "name": "Amiga real",
              "target": "amiga.local:2345",
              "program": "^\"\\${workspaceFolder}/programa.dash\""
            }
          },
          {
            "label": "Dash: ejecutar en DashOS (QEMU)",
            "description": "Compila con ./dash --dashos y lo ejecuta en qemu-aarch64; la salida, en el panel",
            "body": {
              "type": "dash",
              "request": "launch",
              "name": "Ejecutar en DashOS",
              "target": "dashos",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ],
    "walkthroughs": [
      {
        "id": "dash.start",
        "title": "Primeros pasos con Dash",
        "description": "Programas para el Amiga en Dash: un proyecto con su ventana MUI, el emulador y el depurador.",
        "steps": [
          {
            "id": "compilador",
            "title": "Dónde está el compilador",
            "description": "Si tus programas no están dentro del repositorio de Dash, elige su carpeta.\n[Elegir la carpeta de Dash](command:dash.choosePath)",
            "media": {
              "markdown": "walkthrough/compilador.md"
            },
            "completionEvents": [
              "onContext:dash.compilerFound",
              "onSettingChanged:dash.path",
              "onCommand:dash.choosePath"
            ]
          },
          {
            "id": "proyecto",
            "title": "Un proyecto nuevo",
            "description": "Una carpeta con un programa, su ventana y la configuración del depurador.\n[Nuevo proyecto](command:dash.newProject)",
            "media": {
              "markdown": "walkthrough/proyecto.md"
            },
            "completionEvents": [
              "onCommand:dash.newProject"
            ]
          },
          {
            "id": "ventana",
            "title": "La ventana, en el editor visual",
            "description": "Abre ventana.dashui: objetos, propiedades, Ver en Amiga y del evento a su código.\n[Nuevo fichero de ventanas](command:dash.newWindowFile)",
            "media": {
              "markdown": "walkthrough/ventana.md"
            },
            "completionEvents": [
              "onCommand:dash.newWindowFile",
              "onCommand:dash.gotoEvent"
            ]
          },
          {
            "id": "ejecutar",
            "title": "Ejecutar y depurar en el Amiga emulado",
            "description": "Compila, ejecuta en FS-UAE y depura con F5.\n[Ejecutar en emulador](command:dash.runInEmulator)\n[Depurar](command:dash.debug)",
            "media": {
              "markdown": "walkthrough/ejecutar.md"
            },
            "completionEvents": [
              "onCommand:dash.runInEmulator",
              "onCommand:dash.debug",
              "onCommand:dash.compile"
            ]
          },
          {
            "id": "ayuda",
            "title": "La ayuda de Dash, y DashOS",
            "description": "Mayúsculas+F1 sobre un nombre abre su ficha; \"Probar\" ejecuta su ejemplo. \"DashOS\" sobre Main lo ejecuta en QEMU.\n[Abrir la ayuda](command:dash.help.show)\n[Ejecutar en DashOS](command:dash.runInDashOS)",
            "media": {
              "markdown": "walkthrough/ayuda.md"
            },
            "completionEvents": [
              "onCommand:dash.help.show",
              "onCommand:dash.help.search",
              "onCommand:dash.runInDashOS"
            ]
          }
        ]
      }
