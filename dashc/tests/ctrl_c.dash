# Test: Ctrl-C para un programa en un bucle (lo que hace Parar en Forja con run_break, o Break en el Shell). El
# programa se arranca otra vez a sí mismo con run_start; la copia ("hijo") da vueltas a un while sin fin (solo, o
# con un for sin llamadas dentro: el for acaba su vuelta y el while lo ve) o a un for que tarda (con time_delay: lo ve
# el for), o espera a una tarea que da vueltas, y el padre le manda Ctrl-C con run_break: la copia acaba con
# "***Break" y código 5, con la limpieza de siempre.

func vueltas_for()
    Print "hijo for: empieza"
    t = 0
    while true
        for i in (1..1000)
            t = t + i
        end
    end
end

# Un for que acaba solo pero tarda (llama a algo en cada vuelta): también lo mira
func vueltas_lentas()
    Print "hijo lento: empieza"
    for i in (1..100000)
        time_delay(1)
    end
    Print "no llega"
end

# Una tarea de task_start que da vueltas sin fin: Ctrl-C acaba también su función (si no, el programa la esperaría
# para siempre al salir)
func girar(n: Int) -> Int
    t = 0
    while true
        t = t + n
    end
    return t
end

# (no espera a task_done: con la máquina cargada, la tarea acababa por el Ctrl-C y el bucle lo veía antes que su
# propio Ctrl-C, y salía "no llega" con 0. Así, el Ctrl-C para el bucle y, al salir, también tiene que acabar la
# tarea: si no, el programa se quedaría esperándola)
func vueltas_tarea()
    h = task_start(girar, 1)
    Print "hijo tarea: empieza"
    while true
        time_delay(1)
    end
end

func hijo(que: String)
    if que == "tarea"
        vueltas_tarea()
        return
    end
    if que == "for"
        vueltas_for()
        return
    end
    if que == "lento"
        vueltas_lentas()
        return
    end
    Print "hijo: empieza"
    i = 0
    while true
        i = i + 1
    end
end

func probar(que: String)
    h = run_start("\"" + program_path() + "\" hijo " + que, 0)
    time_delay(50)
    run_break(h)
    salida = run_finish(h)
    Print str_trim(salida)
    Print "rc #{run_rc()}"
end

Main
    if arg(0) == "hijo"
        hijo(arg(1))
    else
        probar("while")
        probar("for")
        probar("lento")
        probar("tarea")
    end
end

