# for k in d.keys() con d[k] dentro: el valor de la casilla que se recorre, sin buscar la clave (si d no se pasa a
# nada y k no se reasigna) y la casilla aún guarda k. Textos, enteros y objetos; anidados; k reasignada; d pasado
# a una función; otro nombre del mismo diccionario que le mete claves dentro (la tabla crece y se mueve)
struct Caja
    n: Int = 0
end

func suma(d: {String: Int}) -> Int
    t = 0
    for k in d.keys()
        t = t + d[k]
    end
    return t
end

func mete(d: {String: Int}, k: String)
    d[k + "x"] = 1
end

func copia(d: {String: String}) -> {String: String}
    var e: {String: String} = {}
    for k in d.keys()
        e[k] = d[k] + "!"
    end
    return e
end

Main
    var a: {String: String} = {}
    a["uno"] = "1"
    a["dos"] = "2"
    a["tres"] = "3"
    b = copia(a)
    Print b["uno"] + b["dos"] + b["tres"] + " " + b.length
    var c: {String: Int} = {}
    for i in (1..30)
        c["k" + i] = i
    end
    Print suma(c)
    var cajas: {String: Caja} = {}
    cajas["a"] = Caja(5)
    cajas["b"] = Caja(7)
    t = 0
    for k in cajas.keys()
        t = t + cajas[k].n
    end
    Print t
    # anidados, con el mismo nombre de clave en el de dentro
    pares = 0
    for k in a.keys()
        for j in a.keys()
            if a[k] < a[j]
                pares = pares + 1
            end
        end
    end
    Print pares
    # k reasignada: busca de verdad
    x = ""
    for k in a.keys()
        if k == "uno"
            k = "dos"
        end
        x = x + a[k]
    end
    Print x.length
    # d pasado a una función dentro: busca de verdad
    var d: {String: Int} = {}
    d["p"] = 4
    s = 0
    for k in d.keys()
        mete(d, "q")
        s = s + d[k]
    end
    Print s
    # h es el mismo diccionario que g: meter claves por h mueve la tabla de g; g[k] busca de verdad
    var g: {String: Int} = {}
    for i in (1..6)
        g["g" + i] = i * 10
    end
    h = g
    s = 0
    vueltas = 0
    for k in g.keys()
        if vueltas == 0
            for i in (1..40)
                h["h" + i] = 1000
            end
        end
        vueltas = vueltas + 1
        s = s + g[k]
    end
    Print s
    Print vueltas
    Print g.length
end
