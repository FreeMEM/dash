# Listas: literales, índices, push/pop, for, trozos, parámetros, devolver listas, listas de textos y de listas
func suma(l: Array) -> Int
    s = 0
    for x in l
        s = s + x
    end
    return s
end

func doble(l: Array) -> Array
    r = []
    for x in l
        r.push(x * 2)
    end
    return r
end

func cambia(l: Array)
    l[0] = 100
    l = [7]
    Print l[0]
end


func busca(l: Array, v) -> Int
    i = 0
    for x in l
        if x == v
            return i
        end
        i = i + 1
    end
    return -1
end

func rango(n) -> [Int]
    r = []
    for i in (1..n)
        r.push(i * i)
    end
    return r
end

func nombres(n) -> [String]
    var r: [String] = []
    for i in (1..n)
        r.push("n#{i}")
    end
    return r
end

func une(l: [String]) -> String
    s = ""
    for w in l
        s = s + w + ","
    end
    return s
end

func otra()
    a = [3, 1, 4, 1, 5]
    a.insert(0, 9)
    a.remove(2)
    Print a.length
    Print busca(a, 4)
    Print busca(a, 7)
    q = nombres(3)
    q.insert(1, "medio")
    Print une(q)
    Print q.pop()
    Print une(q)
    q.clear()
    Print q.length
    total = 0
    for k in (1..2000)
        r = rango(5)
        total = total + r[4] + r.length
        m = nombres(2)
        total = total + m[1].length
        for x in r
            if x > 4
                break
            end
            total = total + x
        end
    end
    Print total
    ll = [[1], [2, 3]]
    ll.push([4, 5, 6])
    ll[0].push(7)
    Print ll[0][1]
    Print ll[2].length
    var vacia: [String] = []
    vacia.push("texto")
    Print vacia[0]
end

Main
    otra()
    a = [1, 2, 3]
    a.push(4)
    a[1] = 20
    Print a[1]
    Print a.length
    Print suma(a)
    b = doble(a)
    Print b[3]
    b = a
    b[0] = 9
    Print a[0]
    c = a[1:3]
    Print c.length
    cambia(a)
    Print a[0]
    v = a.pop()
    Print v
    for i in (1..3)
        t = [i, i]
        t.push(i)
        Print t.length
    end
    n = []
    Print n.length
    a = [5]
    Print a[0]
    s = ["x", "y"]
    s.push("z" + "w")
    s[0] = "q"
    for w in s
        Print w
    end
    Print s[2]
    e = [[1, 2], [3]]
    Print e[1][0]
end
