# Otro programa depurado: structs, textos, listas, Float, Bool y globales (dash --debug; las líneas cuentan)
struct Punto
    x: Int = 0
    nombre: String = ""
    hijos: [Punto] = nil
end

var cuenta: Int = 7
var saludo: String = "hola"

func mira(p: Punto, n: Int) -> Int
    t = p.x + n
    return t
end

