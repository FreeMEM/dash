# El depurador: las variables que se ven en cada marco y su valor (Int, String, Bool, Float, structs, listas, nil,
# globales), con .campo y [n]; lo que no se puede.
# expect-out: en mira: 2 [p: Punto] [n: Int]
# expect-out: p = Punto(x: 4, nombre: "dos \"x\"", hijos: [Punto(...)])
# expect-out: n = 2
# expect-out: p.hijos[0].nombre = "uno"
# expect-out: p.hijos[0] = Punto(x: 3, nombre: "uno", hijos: nil)
# expect-out: marco 1: Main 23, 6 variables
# expect-out: lista = [10, 20, 30] [Int]
# expect-out: lista[1] = 20
# expect-out: vacio = nil
# expect-out: f = 1.5 ok = true
# expect-out: globales: 2 cuenta = 7 saludo = "hola"
# expect-out: mal: [? no existe: nada] [? fuera de la lista] [? Punto no tiene z] [? nil]
# expect-out: acabado: 4

Main
    dbg_start("DH0:depurado_datos", "")
    dbg_break("depurado_datos.dash", 12)
    dbg_continue()
    dbg_wait(10000)
    n = dbg_vars(0)
    v0 = dbg_var_name(0, 0) + ": " + dbg_var_type(0, 0)
    v1 = dbg_var_name(0, 1) + ": " + dbg_var_type(0, 1)
    Print "en mira: #{n} [#{v0}] [#{v1}]"
    Print "p = " + dbg_value(0, "p")
    Print "n = " + dbg_value(0, "n")
    Print "p.hijos[0].nombre = " + dbg_value(0, "p.hijos[0].nombre")
    Print "p.hijos[0] = " + dbg_value(0, "p.hijos[0]")
    Print "marco 1: #{dbg_frame_function(1)} #{dbg_frame_line(1)}, #{dbg_vars(1)} variables"
    Print "lista = " + dbg_value(1, "lista") + " [" + dbg_value_type(1, "lista[0]") + "]"
    Print "lista[1] = " + dbg_value(1, "lista[1]")
    Print "vacio = " + dbg_value(1, "vacio")
    Print "f = " + dbg_value(1, "f") + " ok = " + dbg_value(1, "ok")
    g = dbg_globals()
    Print "globales: #{g} " + dbg_global_name(0) + " = " + dbg_value(0, "cuenta") + " " + dbg_global_name(1) + " = " + dbg_value(0, "saludo")
    Print "mal: [" + dbg_value(0, "nada") + "] [" + dbg_value(1, "lista[7]") + "] [" + dbg_value(0, "p.z") + "] [" + dbg_value(1, "vacio.x") + "]"
    dbg_continue()
    Print "acabado: #{dbg_wait(10000)}"
end
