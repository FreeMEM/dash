# El depurador paso a paso: entrar en una función (dbg_step), pasar línea a línea (dbg_next), salir de ella
# (dbg_out) y la pila de llamadas; pasar por encima de una llamada; y parar un programa que no acaba (dbg_pause,
# dbg_end).
# expect-out: en 9: Main 9 1
# expect-out: entra: doble 3 marcos 2: doble 3, Main 9
# expect-out: siguiente: doble 4
# expect-out: sale: Main 10 marcos 1
# expect-out: siguiente: Main 11
# expect-out: acabado: 4
# expect-out: por encima: Main 10
# expect-out: corriendo: 2
# expect-out: pausa: 3 vueltas true
# expect-out: acaba: true 4 20

func donde(e: Int) -> String
    return "#{dbg_function()} #{dbg_line()}"
end

Main
    dbg_start("DH0:depurado", "")
    dbg_break("depurado.dash", 9)
    dbg_continue()
    dbg_wait(10000)
    Print "en 9: #{donde(0)} #{dbg_frames()}"
    dbg_unbreak("depurado.dash", 9)
    dbg_step()
    dbg_wait(10000)
    f0 = dbg_frame_function(0)
    f1 = dbg_frame_function(1)
    Print "entra: #{donde(0)} marcos #{dbg_frames()}: #{f0} #{dbg_frame_line(0)}, #{f1} #{dbg_frame_line(1)}"
    dbg_next()
    dbg_wait(10000)
    Print "siguiente: #{donde(0)}"
    dbg_out()
    dbg_wait(10000)
    Print "sale: #{donde(0)} marcos #{dbg_frames()}"
    dbg_next()
    dbg_wait(10000)
    Print "siguiente: #{donde(0)}"
    dbg_continue()
    Print "acabado: #{dbg_wait(10000)}"

    dbg_start("DH0:depurado", "")
    dbg_break("depurado.dash", 9)
    dbg_continue()
    dbg_wait(10000)
    dbg_unbreak("depurado.dash", 9)
    dbg_next()
    dbg_wait(10000)
    Print "por encima: #{donde(0)}"
    dbg_end(10000)

    dbg_start("DH0:depurado", "bucle")
    dbg_continue()
    time_delay(25)
    Print "corriendo: #{dbg_state()}"
    dbg_pause()
    e = dbg_wait(10000)
    Print "pausa: #{e} #{dbg_function()} #{dbg_line() >= 20}"
    ok = dbg_end(10000)
    Print "acaba: #{ok} #{dbg_state()} #{dbg_rc()}"
end
