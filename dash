#!/usr/bin/env python3
"""Dash 2.0: compila un programa Dash a un ejecutable de Amiga con dashc, sin compilador de C.

    ./dash programa.dash -o programa [--fpu] [--memcheck] [--stack N]

dashc está en dashc/dashc (make -C dashc lo construye). Lo que dashc no hace (C en el programa: @native, @c, @header;
--debug, --small...) lo hace todavía el Dash de Python, la 1.x: ./dash1."""
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.realpath(__file__))
DASHC = os.path.join(ROOT, "dashc", "dashc")
# las opciones de dash1 que dashc aún no tiene
SOLO_DASH1 = {"--multifile", "--small", "-O", "--optimize", "-O0",
              "--no-optimize", "--no-hunk"}


def main():
    args = sys.argv[1:]
    if "--version" in args:
        return subprocess.call([DASHC, "--version"])
    if not args or "-h" in args or "--help" in args:
        print(__doc__.strip())
        return 0 if args else 1
    otras = [a for a in args if a.split("=")[0] in SOLO_DASH1]
    if otras:
        print(f"dash: {' '.join(otras)} no lo hace aún dashc (Dash 2.0); con el Dash 1.x: ./dash1 {' '.join(args)}",
              file=sys.stderr)
        return 1
    # (-v y -q de dash1 no hacen falta: dashc solo escribe si hay un error)
    args = [a for a in args if a not in ("-v", "--verbose", "-q", "--quiet")]
    if os.environ.get("DASH_PROFILE") == "1" and "--perfil" not in args and "--profile" not in args:
        args.append("--perfil")        # (como dash1: tools/medir_visor.py --perfil)
    if not os.path.exists(DASHC):
        print("dash: falta dashc; constrúyelo con: make -C dashc", file=sys.stderr)
        return 1
    r = subprocess.run([DASHC, *args], capture_output=True, text=True, errors="replace")
    sys.stdout.write(r.stdout)
    err = r.stderr
    if re.search(r"(lleva C|no admite C)", err):
        err += "dash: Dash 2.0 no compila C en los programas; el Dash 1.x sí: ./dash1 " + " ".join(sys.argv[1:]) + "\n"
    sys.stderr.write(err)
    return r.returncode


if __name__ == "__main__":
    sys.exit(main())
