#!/usr/bin/env python3
"""Dash: compila un programa Dash a un ejecutable de Amiga.

    ./dash programa.dash -o programa [--fpu] [--cpu 68040] [--memcheck] [--stack N] [--debug]
    ./dash --gcc programa.dash -o programa [...]

Sin --gcc, el compilador de Dash genera él mismo el código del Amiga (no hace falta un compilador de C).
Con --gcc, el programa pasa a C y lo compila el gcc de Amiga de bebbo, como en la 1.x. Lo que el compilador
propio no hace (C en el programa: @native, @c, @header; -O, --small, --multifile...) va solo por C con gcc,
y lo dice en una línea."""
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.realpath(__file__))
NATIVO = os.path.join(ROOT, "dashc", "dashc")
CON_GCC = os.path.join(ROOT, "dash1")       # el camino por C (pieza interna: se usa con --gcc)
# opciones que solo tiene el camino por C
SOLO_GCC = {"--multifile", "--small", "-O", "--optimize", "-O0",
            "--no-optimize", "--no-hunk"}
NOTA = "se compila por C con gcc"            # (la extensión de VS Code la busca para saber cómo depurar)


def por_c(args, motivo=None):
    """El programa por C con gcc; con motivo, una línea que dice por qué"""
    if motivo:
        print(f"dash: {motivo}: {NOTA}", file=sys.stderr)
        sys.stderr.flush()
    return subprocess.call([sys.executable, CON_GCC, *args])


def main():
    args = sys.argv[1:]
    if "--gcc" in args:
        return por_c([a for a in args if a != "--gcc"])
    if "--version" in args:
        return subprocess.call([NATIVO, "--version"])
    if not args or "-h" in args or "--help" in args:
        print(__doc__.strip())
        return 0 if args else 1
    otras = [a for a in args if a.split("=")[0] in SOLO_GCC]
    if otras:
        return por_c(args, " ".join(otras))
    # (-v y -q no hacen falta: el compilador solo escribe si hay un error)
    nat = [a for a in args if a not in ("-v", "--verbose", "-q", "--quiet")]
    if os.environ.get("DASH_PROFILE") == "1" and "--perfil" not in nat and "--profile" not in nat:
        nat.append("--perfil")        # (tools/medir_visor.py --perfil)
    if not os.path.exists(NATIVO):
        print("dash: falta el compilador; constrúyelo con: make -C dashc", file=sys.stderr)
        return 1
    r = subprocess.run([NATIVO, *nat], capture_output=True, text=True, errors="replace")
    sys.stdout.write(r.stdout)
    if r.returncode and re.search(r"(lleva C|no admite C)", r.stderr):
        return por_c(args, "el programa lleva C")
    sys.stderr.write(r.stderr)
    return r.returncode


if __name__ == "__main__":
    sys.exit(main())
