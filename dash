#!/usr/bin/env python3
"""Dash: compila un programa Dash a un ejecutable de Amiga.

    ./dash programa.dash -o programa [--fpu] [--cpu 68040] [--memcheck] [--stack N] [--debug]
    ./dash --gcc programa.dash -o programa [...]
    ./dash --dashos programa.dash -o programa [--memcheck] [--gcc] [--pie] [--be]


Sin --gcc, el compilador de Dash genera él mismo el código del Amiga (no hace falta un compilador de C).
Con --gcc, el programa pasa a C y lo compila el gcc de Amiga de bebbo, como en la 1.x. Lo que el compilador
propio no hace (C en el programa: @native, @c, @header; -O, --small, --multifile...) va solo por C con gcc,
y lo dice en una línea.

CPU y FPU (con o sin --gcc):
  --cpu X   68000 (por defecto: arranca en cualquier Amiga), 68020, 68030, 68040 o 68060. Desde 68020
            multiplica y divide en una instrucción: va más rápido en un Amiga acelerado, pero el programa
            no arranca en una CPU inferior. Con --gcc, además, el código se afina para la CPU elegida.
  --fpu     Float y Double con la FPU (68881/68882, o la del 68040/68060). Pide un 68020 o más y el
            programa no arranca sin FPU. Se combina con --cpu.

Con --dashos, el programa es para DashOS (AArch64 little-endian, ELF), también directo y enlazado con ld.lld; con
--dashos --gcc, por C con clang (docs/AARCH64_LOOP.md). Con --pie, el ejecutable funciona cargado en cualquier
dirección (si no, va fijo en 0x400000). Con --be, big-endian: las bibliotecas de la caja Amiga.
tools/dashos_run.py lo ejecuta en el PC con qemu-aarch64 (o qemu-aarch64_be)."""
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.realpath(__file__))
NATIVO = os.path.join(ROOT, "dashc", "dashc")
CON_GCC = os.path.join(ROOT, "dash1")       # el camino por C (pieza interna: se usa con --gcc)
# opciones que solo tiene el camino por C
SOLO_GCC = {"--multifile", "--small", "-O", "--optimize", "-O0",
            "--no-optimize", "--no-hunk"}
NOTA = "se compila por C con gcc"            # (la extensión de VS Code la busca para saber cómo depurar)


def por_c(args, motivo=None):
    """El programa por C con gcc; con motivo, una línea que dice por qué"""
    if motivo:
        print(f"dash: {motivo}: {NOTA}", file=sys.stderr)
        sys.stderr.flush()
    return subprocess.call([sys.executable, CON_GCC, *args])


def dashos(args):
    """--dashos: directo (dashc-a64) o, con --gcc, por C con clang (tools/dashos_run.py, plataforma de DashOS)"""
    sys.path.insert(0, os.path.join(ROOT, "tools"))
    import dashos_run
    from pathlib import Path
    por_gcc = "--gcc" in args
    opts = [a for a in args if a not in ("--dashos", "--gcc")]
    out = opts[opts.index("-o") + 1] if "-o" in opts else None
    srcs = [a for a in opts if a.endswith(".dash")]
    otras = [a for a in opts if a.startswith("-") and a not in ("-o", "--memcheck", "--pie", "--be")]
    if not out or len(srcs) != 1 or otras:
        print("uso: dash --dashos programa.dash -o programa [--memcheck] [--pie] [--be]" +
              (f" (DashOS aún no admite {' '.join(otras)})" if otras else ""), file=sys.stderr)
        return 1
    if not por_gcc and not os.path.exists(os.path.join(ROOT, "dashc", "dashc-a64")):
        print("dash: falta el compilador para DashOS; constrúyelo con: make -C dashc dashc-a64", file=sys.stderr)
        return 1
    ok, msg = (dashos_run.build if por_gcc else dashos_run.build_direct)(
        Path(srcs[0]).resolve(), Path(out).resolve(), linux=False, memcheck="--memcheck" in opts,
        pie="--pie" in opts, be="--be" in opts)
    if not ok:
        sys.stderr.write(msg)
    return 0 if ok else 1


def main():
    args = sys.argv[1:]
    if "--dashos" in args:
        return dashos(args)
    if "--gcc" in args:
        return por_c([a for a in args if a != "--gcc"])
    if "--version" in args:
        return subprocess.call([NATIVO, "--version"])
    if not args or "-h" in args or "--help" in args:
        print(__doc__.strip())
        return 0 if args else 1
    otras = [a for a in args if a.split("=")[0] in SOLO_GCC]
    if otras:
        return por_c(args, " ".join(otras))
    # (-v y -q no hacen falta: el compilador solo escribe si hay un error)
    nat = [a for a in args if a not in ("-v", "--verbose", "-q", "--quiet")]
    if os.environ.get("DASH_PROFILE") == "1" and "--perfil" not in nat and "--profile" not in nat:
        nat.append("--perfil")        # (tools/medir_visor.py --perfil)
    if not os.path.exists(NATIVO):
        print("dash: falta el compilador; constrúyelo con: make -C dashc", file=sys.stderr)
        return 1
    r = subprocess.run([NATIVO, *nat], capture_output=True, text=True, errors="replace")
    sys.stdout.write(r.stdout)
    if r.returncode and re.search(r"(lleva C|no admite C)", r.stderr):
        return por_c(args, "el programa lleva C")
    sys.stderr.write(r.stderr)
    return r.returncode


if __name__ == "__main__":
    sys.exit(main())
