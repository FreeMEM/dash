# ========================================
# Handlers de DOS (sistemas de archivos) escritos en Dash
# Las estructuras de AmigaOS, las constantes de los paquetes y ayudas para cerraduras, FileInfoBlock e InfoData.
# Importarlo hace del programa un handler (como ./dash --handler): ver docs/HANDLER_LOOP.md y la sección de
# handlers del manual. Idea del usuario.
# ========================================

@handler

# ---- Estructuras (dos/dosextens.h, dos/filehandler.h, dos/dos.h) ----

@amiga struct DosPacket
    dp_Link: Long        # su Message
    dp_Port: Long        # el puerto de respuesta
    dp_Type: Long        # ACTION_...
    dp_Res1: Long
    dp_Res2: Long
    dp_Arg1: Long
    dp_Arg2: Long
    dp_Arg3: Long
    dp_Arg4: Long
    dp_Arg5: Long
    dp_Arg6: Long
    dp_Arg7: Long
end

@amiga struct DateStamp
    ds_Days: Long        # desde el 1 de enero de 1978
    ds_Minute: Long
    ds_Tick: Long        # 50 por segundo
end

@amiga struct FileLock
    fl_Link: BPtr
    fl_Key: Long         # lo que el handler quiera: su número del objeto
    fl_Access: Long      # SHARED_LOCK o EXCLUSIVE_LOCK
    fl_Task: Long        # el puerto del handler
    fl_Volume: BPtr      # su volumen (DosList)
end

@amiga struct FileHandle
    fh_Link: Long
    fh_Port: Long        # verdadero si es interactivo (una consola): 0 en un sistema de archivos
    fh_Type: Long        # el puerto del handler
    fh_Buf: BPtr
    fh_Pos: Long
    fh_End: Long
    fh_Funcs: Long
    fh_Func2: Long
    fh_Func3: Long
    fh_Args: Long        # lo que el handler quiera: su número del fichero abierto (llega en dp_Arg1 de READ...)
    fh_Arg2: Long
end

@amiga struct FileInfoBlock
    fib_DiskKey: Long
    fib_DirEntryType: Long   # ST_FILE (< 0) o ST_ROOT, ST_USERDIR (> 0)
    fib_FileName: UByte[108] # BSTR
    fib_Protection: Long     # bits RWED al revés (0 = todo permitido), y HSPA
    fib_EntryType: Long
    fib_Size: Long
    fib_NumBlocks: Long
    fib_Date: DateStamp
    fib_Comment: UByte[80]   # BSTR
    fib_OwnerUID: UWord
    fib_OwnerGID: UWord
    fib_Reserved: UByte[32]
end

@amiga struct InfoData
    id_NumSoftErrors: Long
    id_UnitNumber: Long
    id_DiskState: Long       # ID_WRITE_PROTECTED, ID_VALIDATING, ID_VALIDATED
    id_NumBlocks: Long
    id_NumBlocksUsed: Long
    id_BytesPerBlock: Long
    id_DiskType: Long        # ID_DOS_DISK...
    id_VolumeNode: BPtr
    id_InUse: Long
end

@amiga struct DeviceNode
    dn_Next: BPtr
    dn_Type: Long
    dn_Task: Long
    dn_Lock: BPtr
    dn_Handler: BPtr
    dn_StackSize: Long
    dn_Priority: Long
    dn_Startup: BPtr
    dn_SegList: BPtr
    dn_GlobalVec: BPtr
    dn_Name: BPtr
end

@amiga struct FileSysStartupMsg
    fssm_Unit: ULong
    fssm_Device: BPtr        # BSTR con un 0 detrás
    fssm_Environ: BPtr       # DosEnvec
    fssm_Flags: ULong
end

@amiga struct DosEnvec
    de_TableSize: ULong
    de_SizeBlock: ULong      # en longs (128 = 512 bytes)
    de_SecOrg: ULong
    de_Surfaces: ULong
    de_SectorPerBlock: ULong
    de_BlocksPerTrack: ULong
    de_Reserved: ULong
    de_PreAlloc: ULong
    de_Interleave: ULong
    de_LowCyl: ULong
    de_HighCyl: ULong
    de_NumBuffers: ULong
    de_BufMemType: ULong
    de_MaxTransfer: ULong
    de_Mask: ULong
    de_BootPri: ULong
    de_DosType: ULong
    de_Baud: ULong
    de_Control: ULong
    de_BootBlocks: ULong
end

# ---- Paquetes (dos/dosextens.h) ----

