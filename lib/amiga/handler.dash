# ---- Otros valores ----

const DOSTRUE = -1
const DOSFALSE = 0
const SHARED_LOCK = -2           # ACCESS_READ
const EXCLUSIVE_LOCK = -1        # ACCESS_WRITE
const ST_ROOT = 1
const ST_USERDIR = 2
const ST_FILE = -3
const OFFSET_BEGINNING = -1
const OFFSET_CURRENT = 0
const OFFSET_END = 1
const ID_WRITE_PROTECTED = 80
const ID_VALIDATING = 81
const ID_VALIDATED = 82
const ID_DOS_DISK = 0x444F5300   # "DOS\0"
const FIBF_ARCHIVE = 16          # (los de RWED van al revés: un bit puesto quita el permiso)
const FIBF_READ = 8
const FIBF_WRITE = 4
const FIBF_EXECUTE = 2
const FIBF_DELETE = 1
const TD_MOTOR = 9
const TD_CHANGESTATE = 14
const CMD_UPDATE = 4

# ---- BPTR ----

# la dirección de un BPTR
func baddr(b: Int) -> Int
    return b << 2
end

# el BPTR de una dirección (múltiplo de 4)
func mkbptr(a: Int) -> Int
    return a >> 2
end

# ---- Cerraduras ----

# Una cerradura nueva del handler: su BPTR (lo que se contesta a LOCATE_OBJECT, COPY_DIR, PARENT...), 0 sin memoria.
# key es lo que el handler quiera para saber qué objeto es; volume, lo que dio handler_volume_add.
func lock_new(key: Int, access: Int, volume: Int) -> Int
    m = amiga_alloc(sizeof(FileLock))
    if m == 0
        return 0
    end
    l = Ptr FileLock(m)
    l.fl_Key = key
    l.fl_Access = access
    l.fl_Task = handler_port()
    l.fl_Volume = mkbptr(volume)
    return mkbptr(m)
end

# el key de una cerradura (su BPTR); 0 para la cerradura 0 (la raíz)
func lock_key(lock: Int) -> Int
    if lock == 0
        return 0
    end
    return Ptr FileLock(baddr(lock)).fl_Key
end

# libera una cerradura de lock_new (FREE_LOCK)
func lock_free(lock: Int)
    if lock != 0
        amiga_free(baddr(lock), sizeof(FileLock))
    end
end

# ---- Fechas ----

# 1978-01-01 en segundos de Unix
const _AMIGA_EPOCH = 252460800

# Pone en d (la dirección de un DateStamp) la fecha de Unix t (segundos desde 1970)
func datestamp_set(d: Int, t: Int)
    s = t - _AMIGA_EPOCH
    if s < 0
        s = 0
    end
    ds = Ptr DateStamp(d)
    ds.ds_Days = s / 86400
    r = s % 86400
    ds.ds_Minute = r / 60
    ds.ds_Tick = (r % 60) * 50
end

# ---- FileInfoBlock (EXAMINE_OBJECT, EXAMINE_NEXT, EXAMINE_FH) ----

# Rellena el FileInfoBlock fib (su dirección): type ST_FILE, ST_ROOT o ST_USERDIR; protection con los bits de
# FileInfoBlock (0 = todo permitido); time en segundos de Unix
func fib_fill(fib: Int, key: Int, type: Int, name: String, size: Int, protection: Int, time: Int, comment: String)
    f = Ptr FileInfoBlock(fib)
    f.fib_DiskKey = key
    f.fib_DirEntryType = type
    f.fib_EntryType = type
    bstr_put(fib + offsetof(FileInfoBlock, fib_FileName), name, 108)
    f.fib_Protection = protection
    f.fib_Size = size
    f.fib_NumBlocks = (size + 511) / 512
    datestamp_set(fib + offsetof(FileInfoBlock, fib_Date), time)
    bstr_put(fib + offsetof(FileInfoBlock, fib_Comment), comment, 80)
    f.fib_OwnerUID = 0
    f.fib_OwnerGID = 0
end

# ---- InfoData (DISK_INFO, INFO) ----

func info_fill(info: Int, blocks: Int, used: Int, block_size: Int, state: Int, volume: Int)
    d = Ptr InfoData(info)
    d.id_NumSoftErrors = 0
    d.id_UnitNumber = 0
    d.id_DiskState = state
    d.id_NumBlocks = blocks
    d.id_NumBlocksUsed = used
    d.id_BytesPerBlock = block_size
    d.id_DiskType = ID_DOS_DISK
    d.id_VolumeNode = mkbptr(volume)
    d.id_InUse = 0
end

# ---- El arranque con Device= (FileSysStartupMsg) ----

# la FileSysStartupMsg del montaje (su dirección), o 0 sin Device=
func handler_fssm() -> Int
    s = handler_startup()
    if s <= 0 or s >= 0x40000000
        return 0
    end
    return baddr(s)
end

# el nombre del dispositivo del montaje ("trackdisk.device"), "" sin Device=
func fssm_device() -> String
    f = handler_fssm()
    if f == 0
        return ""
    end
    return bstr_text(Ptr FileSysStartupMsg(f).fssm_Device)
end

func fssm_unit() -> Int
    f = handler_fssm()
    if f == 0
        return 0
    end
    return Ptr FileSysStartupMsg(f).fssm_Unit
end

# el DosEnvec del montaje (su dirección: geometría, LowCyl, HighCyl...), 0 sin Device=
func fssm_env() -> Int
    f = handler_fssm()
    if f == 0
        return 0
    end
    return baddr(Ptr FileSysStartupMsg(f).fssm_Environ)
end

# abre el dispositivo del montaje (dev_open con su unidad y flags): 0 si no hay o no abre
func fssm_open() -> Int
    f = handler_fssm()
    if f == 0
        return 0
    end
    m = Ptr FileSysStartupMsg(f)
    return dev_open(bstr_text(m.fssm_Device), m.fssm_Unit, m.fssm_Flags)
end

# el primer bloque de la partición (bloques de 512 bytes por de_SizeBlock 128)
func fssm_first_block() -> Int
    e = fssm_env()
    if e == 0
        return 0
    end
    d = Ptr DosEnvec(e)
    return d.de_LowCyl * d.de_Surfaces * d.de_BlocksPerTrack
end

# cuántos bloques tiene la partición
func fssm_blocks() -> Int
    e = fssm_env()
    if e == 0
        return 0
    end
    d = Ptr DosEnvec(e)
    return (d.de_HighCyl - d.de_LowCyl + 1) * d.de_Surfaces * d.de_BlocksPerTrack
end

# el tamaño de bloque en bytes
func fssm_block_size() -> Int
    e = fssm_env()
    if e == 0
        return 512
    end
    return Ptr DosEnvec(e).de_SizeBlock * 4
end
