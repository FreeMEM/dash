const ACTION_EXAMINE_OBJECT = 23
const ACTION_EXAMINE_NEXT = 24
const ACTION_DISK_INFO = 25
const ACTION_INFO = 26
const ACTION_FLUSH = 27
const ACTION_SET_COMMENT = 28
const ACTION_PARENT = 29
const ACTION_INHIBIT = 31
const ACTION_SET_DATE = 34
