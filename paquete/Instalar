; Instalador de Dash para el Installer del sistema (AmigaOS 2.0 a 3.2).
; Copia el cajón Dash (la orden dash, sus runtimes, lib/ y los ejemplos) donde se elija y añade a S:User-Startup el
; Assign DASH: y el Path, para escribir "dash" desde cualquier Shell. Habla en inglés, o en castellano si el
; sistema lo está. Este fichero se escribe en UTF-8 y tools/paquete_amiga.py lo pasa a ISO-8859-1, que es lo que
; lee el Amiga.

(set @app-name "Dash")
(set #es (OR (= @language "español") (= @language "spanish")))

(welcome
    (if #es "Este programa instala Dash @VERSION@: el compilador de Dash (la orden dash), que corre en el propio Amiga y hace ejecutables sin compilador de C. Trae también Forja, su entorno de programación, Inferencia, la IA que programa en el Amiga, y dashgit, un git escrito en Dash (en alfa: queda mucho por probar)."
            "This program installs Dash @VERSION@: the Dash compiler (the dash command), which runs on the Amiga itself and makes executables without a C compiler. It also brings Forja, its programming environment, Inferencia, the AI that programs on the Amiga, and dashgit, a git written in Dash (in alpha: much is still to be tested)."))

(if (< (/ (getversion "exec.library" (resident)) 65536) 36)
    (message (if #es "Dash necesita AmigaOS 2.0 o superior. Se instalará igual."
                     "Dash needs AmigaOS 2.0 or later. It will be installed anyway.")))

; --- Dónde: encima de la de antes si hay DASH: (y se quiere); si no, se pregunta (Work: si lo hay; si no, SYS:) ---
(set #antes (getassign "DASH" "a"))
(set #cajon "")
(if (AND (<> #antes "") (exists #antes (noreq)))
    (if (askbool
            (prompt (if #es (cat "Ya hay Dash en " #antes ". ¿Lo pongo al día ahí?")
                            (cat "Dash is already in " #antes ". Shall I update it there?")))
            (help @askbool-help)
            (default 1))
        (set #cajon #antes)))
(if (= #cajon "")
    (set #cajon (tackon
        (askdir
            (prompt (if #es "¿Dónde instalo Dash? Se creará ahí el cajón \"Dash\"."
                            "Where should Dash go? The \"Dash\" drawer will be made there."))
            (help @askdir-help)
            (default (if (exists "Work:" (noreq)) "Work:" "SYS:")))
        "Dash")))
(set #donde (pathonly #cajon))
(set @default-dest #cajon)

; --- Copiar: todo el cajón menos el instalador ---
(if (not (exists #cajon (noreq)))
    (makedir #cajon (infos)))
; el icono del cajón, el del paquete (su ventana tiene el tamaño para sus iconos), si está al lado
(if (AND (exists "/Dash.info" (noreq)) (= (fileonly #cajon) "Dash"))
    (copyfiles (source "/Dash.info") (dest #donde) (nogauge)))
(foreach "" "#?"
    (if (AND (<> @each-name "Instalar") (<> @each-name "Instalar.info"))
        (if (= @each-type 2)
            ((set #ya (tackon #cajon @each-name))
             ; un fichero con el nombre de un cajón del paquete (un Forja compilado ahí): aparte, como .antes
             (if (= (exists #ya (noreq)) 1)
                 (rename #ya (cat #ya ".antes")))
             (copyfiles (source @each-name) (dest #ya) (all) (infos)))
            (copyfiles (source @each-name) (dest #cajon)))))

; --- DASH: y el Path, en S:User-Startup (entre ;BEGIN Dash y ;END Dash: otra instalación lo cambia) ---
(startup "Dash"
    (prompt (if #es "Añado a S:User-Startup el Assign DASH: y el Path, para usar dash, forja e inferencia desde cualquier Shell."
                    "I add the DASH: assign and the Path to S:User-Startup, to use dash, forja and inferencia from any Shell."))
    (help @startup-help)
    ; (solo si el cajón está: si un día se mueve, el arranque no se para en "Can't find")
    ; (Forja e Inferencia también en el Path: "forja" o "inferencia" desde cualquier Shell, como pidió Ferrán)
    ; (cada cajón con su If: un Path a un cajón que no está también pararía el arranque)
    (command (cat "If EXISTS \"" #cajon "\"\n  Assign DASH: \"" #cajon "\"\n  Path DASH: ADD\nEndIf\n"
                  "If EXISTS \"" (tackon #cajon "Forja") "\"\n  Path DASH:Forja ADD\nEndIf\n"
                  "If EXISTS \"" (tackon #cajon "Inferencia") "\"\n  Path DASH:Inferencia ADD\nEndIf\n")))
(run (cat "Assign DASH: \"" #cajon "\""))

; --- Forja: dónde está la orden dash (ENV:Forja/dashc), para que funcione ya, sin reiniciar: el Path de
; User-Startup no llega al Workbench que está en marcha. Solo si no lo había puesto el usuario ---
(set #forja (not (exists "ENVARC:Forja/dashc" (noreq))))
(if (AND #forja (not (exists "ENVARC:Forja" (noreq)))) (makedir "ENVARC:Forja"))
(if (AND #forja (not (exists "ENV:Forja" (noreq)))) (makedir "ENV:Forja"))
; (DASH:dash, no la ruta entera: sigue valiendo si el cajón se mueve)
(if #forja (textfile (dest "ENVARC:Forja/dashc") (append "DASH:dash")))
(if #forja (textfile (dest "ENV:Forja/dashc") (append "DASH:dash")))

(exit (if #es
          (cat "Dash está en " #cajon ".\n\n"
               "Desde un Shell nuevo (o tras reiniciar), para compilar un ejemplo:\n"
               "  dash DASH:examples/hola.dash -o RAM:hola\n"
               "y para ejecutarlo:\n"
               "  RAM:hola\n\n"
               "Con --fpu (68020 y FPU), --memcheck y --stack. Más en DASH:LEEME.\n\n"
               "Forja, el entorno de programación, está en DASH:Forja.")
          (cat "Dash is in " #cajon ".\n\n"
               "From a new Shell (or after rebooting), to build an example:\n"
               "  dash DASH:examples/hola.dash -o RAM:hola\n"
               "and to run it:\n"
               "  RAM:hola\n\n"
               "With --fpu (68020 and FPU), --memcheck and --stack. More in DASH:README.\n\n"
               "Forja, the programming environment, is in DASH:Forja.")))
