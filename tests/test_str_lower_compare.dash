# str_lower(x) == "texto" (or !=) with a literal already in lower case compares without making the
# lowered copy (_dash_str_ieq); same result, also with Latin-1 letters (Á and á) and nil (as "").
# expect-c: _dash_str_ieq(v, "inherit") == TRUE
# expect-out: si
# expect-out: distinto
# expect-out: 1 0
# expect-out: vacío 1
# expect-out: fin

Main
    v = "INHERIT"
    if str_lower(v) == "inherit"
        Print "si"
    end
    if "auto" != str_lower("AUTÓ")
        Print "distinto"
    end
    Print "#{str_lower(\"ÁRBOL\") == \"árbol\"} #{str_lower(\"ÁRBOLES\") == \"árbol\"}"
    var nada: String = nil
    Print "vacío #{str_lower(nada) == \"\"}"
    Print "fin"
end
