# Test: font_from_ttf (Dash 2.0, what Tachyon did with @native): a tiny TrueType font made on the PC with fontTools
# (1000 units of em, ascent 800, descent 200; "A" a 600 x 700 square, advance 700; "B" 300 x 700, advance 400; space
# 300), and the same font as WOFF (zlib) and WOFF2 (Brotli, glyf and loca transformed), written to RAM: and made Amiga
# fonts at 20 px of em: the three give the same sizes. Also at 50 % of its width, a missing file and one that is not a
# font.
# expect-out: ttf: 20 16 14 22 48
# expect-out: woff: 20 16 14 22 48
# expect-out: woff2: 20 16 14 22 48
# expect-out: ancho 50: 7 11
# expect-out: no está: 0
# expect-out: no es fuente: 0
# expect-out: icono: 8 0

func escribir(nombre: String, datos: Array) -> Bool
    b = buffer_alloc(datos.length)
    i = 0
    for x in datos
        buffer_set_byte(b, i, x)
        i = i + 1
    end
    ok = file_save(nombre, b, datos.length)
    buffer_free(b)
    return ok
end

# alto, línea base y anchos de "A", "AB" y "A B A" con la fuente
func medir(nombre: String, fichero: String)
    f = font_from_ttf(fichero, 20, 0)
    if f == 0
        Print "#{nombre}: 0"
        return
    end
    font_use(f)
    a = font_text_width("A")
    ab = font_text_width("AB")
    aba = font_text_width("A B A")
    Print "#{nombre}: #{font_size(f)} #{font_baseline() + 1} #{a} #{ab} #{aba}"
    font_ttf_free(f)
end

