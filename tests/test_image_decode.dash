# Test: image_decode (Dash 2.0, what Tachyon did with @native): small pictures made on the PC with PIL (16 x 8:
# the left half red, the right half blue, the last row green; the JPEGs and a WebP at 64 x 32; an SVG, drawn), written to RAM: and decoded
# by the program itself, without datatypes. The JPEGs are reduced while they decode (TJpgDec: 1/2, 1/4), a
# progressive JPEG goes through stb_image, and the sizes and corner colours are checked (JPEG: near enough).
# expect-out: png: 16x8 false rojo azul verde
# expect-out: png con alfa: 16x8 true rojo azul verde
# expect-out: gif: 16x8 true rojo azul verde
# expect-out: bmp: 16x8 false rojo azul verde
# expect-out: jpg: 64x32 false rojo azul verde
# expect-out: jpg a 16x8: 16x8 false rojo azul verde
# expect-out: jpg a 32x16: 32x16 false rojo azul verde
# expect-out: jpg progresivo a 16x8: 16x8 false rojo azul verde
# expect-out: webp: 64x32 false rojo azul verde
# expect-out: webp a 16x8: 16x8 false rojo azul verde
# expect-out: webp sin pérdida con alfa: 16x8 true rojo azul verde
# expect-out: svg: 16x8 true rojo azul verde
# expect-out: svg a 32x16: 32x16 true rojo azul verde
# expect-out: no es imagen: 0
# expect-out: no está: 0

func escribir(nombre: String, datos: Array) -> Bool
    b = buffer_alloc(datos.length)
    i = 0
    for x in datos
        buffer_set_byte(b, i, x)
        i = i + 1
    end
    ok = file_save(nombre, b, datos.length)
    buffer_free(b)
    return ok
end

# el color de un píxel (por su canal más fuerte)
func color(d: Int, x: Int, y: Int) -> String
    c = 3
    if image_decoded_alpha(d)
        c = 4
    end
    p = image_decoded_pixels(d) + (y * image_decoded_width(d) + x) * c
    r = buffer_get_byte(p, 0)
    g = buffer_get_byte(p, 1)
    b = buffer_get_byte(p, 2)
    if r > 160 and g < 90 and b < 90
        return "rojo"
    end
    if b > 160 and r < 90 and g < 90
        return "azul"
    end
    if g > 160 and r < 90 and b < 90
        return "verde"
    end
    return "#{r},#{g},#{b}"
end

func probar(nombre: String, fichero: String, maxw: Int, maxh: Int)
    d = image_decode(fichero, maxw, maxh)
    if d == 0
        Print "#{nombre}: 0"
        return
    end
    w = image_decoded_width(d)
    h = image_decoded_height(d)
    Print "#{nombre}: #{w}x#{h} #{image_decoded_alpha(d)} #{color(d, 0, 0)} #{color(d, w - 1, 0)} #{color(d, 0, h - 1)}"
    image_decoded_free(d)
end

