# Test: loops and functions that cannot leave temporaries (strings, arrays,
# structs) lose the temporaries mark and its releases (compiler/tmp_marks.py);
# the ones that can keep them, and the program still frees what it makes.
#
# The pure Int loop and doble() have no mark:
# expect-no-c: ULONG _dash_tm1 = _dash_tmp_mark();
# expect-no-c: LONG doble(LONG x) {\n    ULONG _dash_fm
# The loop that builds strings and saludo() (returns one) keep it:
# expect-c: ULONG _dash_tm2 = _dash_tmp_mark();
# expect-c: _dash_tmp_release_keep(_dash_fm, _dash_r);
# A loop that only reads an array and calls doble() has none either:
# expect-no-c: ULONG _dash_tm3 = _dash_tmp_mark();
#
# expect-out: 110
# expect-out: n3
# expect-out: 30

func doble(x)
    return x * 2
end

func saludo(n)
    return "n" + n
end

Main
    t = 0
    for i in (1..10)
        t = t + doble(i)
    end
    s = ""
    for i in (1..3)
        s = saludo(i)
    end
    nums = [1, 2, 3, 4, 5]
    u = 0
    for v in nums
        u = u + doble(v)
    end
    Print t
    Print s
    Print u
end
