# Test: struct typing
# Self-referencing and forward-referenced structs, string fields in
# expressions, methods returning strings, chained member access
#
# expect-c: typedef struct _Dash_Nodo _Dash_Nodo;
# expect-c: _Dash_Nodo * sig;
# expect-c: _Dash_Caja * caja;
# expect-c: Printf("%ld\n", _DASH_NN(_DASH_NN(b, 0x2b)->sig, 0x2b)->valor);
# expect-c: _dash_r = DashString_concat_h("Hola ", sizeof("Hola ") - 1, self->nombre, -1);
# expect-c: _dash_str_set(&s, Persona_saludo(_DASH_NN(p, 0x32)));
# expect-c: Printf("%s\n", Persona_saludo(_DASH_NN(p, 0x34)));
# expect-c: _dash_block_get(sizeof(_Dash_RefHeader) + size)
#
# expect-out: 1
# expect-out: 5
# expect-out: Hola Ana
# expect-out: Hola Ana

struct Nodo
    valor: Int
    sig: Nodo
end

struct Estante
    caja: Caja
end

struct Caja
    peso: Int
end

struct Persona
    nombre: String

    func saludo() -> String
        return "Hola " + self.nombre
    end
end

Main
    a = Nodo(1, 0)
    b = Nodo(2, a)
    Print b.sig.valor

    c = Caja(5)
    e = Estante(c)
    Print e.caja.peso

    p = Persona("Ana")
    s = p.saludo()
    Print s
    Print p.saludo()
end
