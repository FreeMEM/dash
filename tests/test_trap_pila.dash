# Test: an exception in a program with @stack, built by ./dash (straight to hunk), with a heavy MUI window open.
# ./dash put the trap handler on before swapping to the stack of @stack, so the recovery (the message and the
# cleanup, which disposes the whole window) ran on the Shell's stack (4 KB) and overflowed it: the program
# vanished with no message, not even what it had printed, and without giving back its memory (Tachyon in
# Amiberry with JIT). The exception here: a Float operation built with --fpu, on an A1200 with no FPU (line F).
# emu-needs: muimaster.library
# dash-direct: --fpu
# expect-rc: 20
# expect-out: ventana abierta
# expect-out: Error: instrucción de línea F (excepción 11)
# ignore-out: en 

@stack 400000

func hondo(n: Int, b: Int) -> Int
    if n == 0
        f = Float(b) * 1.5
        return Int(f)
    end
    return hondo(n - 1, b) + 1
end

Main
    if mui_app_begin("Trampa", "DASHTRAMPAPILA") == 0
        Print "sin MUI"
    else
        win = mui_window_begin("Trampa", 0)
        for i in (1..20)
            mui_vgroup_begin()
        end
        for j in (1..10)
            mui_button("botón")
        end
        for i in (1..20)
            mui_group_end()
        end
        mui_window_end()
        mui_window_open(win)
        Print "ventana abierta"
        Print hondo(2000, 0)
        Print "no llega"
    end
end
