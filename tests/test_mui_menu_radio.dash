# Options (radio items) in the menus of a MUI window: the options one after another are a group, and choosing one
# marks it and unmarks the others (MUIA_Menuitem_Exclude and MUI's notifications). A helper process types Amiga+L
# (an option of the menu), Amiga+N (one of a submenu, another group), Amiga+L again (a marked option stays marked)
# and Amiga+Q through input.device. mui_get_value / mui_set_value read and set the marks.
# emu-needs: muimaster.library
# expect-out: al empezar: 1 0 / 0 1
# expect-out: poner: 0 1 / 1 0
# expect-out: menú 22: 0 1 / 0 1
# expect-out: menú 30: 0 1 / 1 0
# expect-out: menú 22: 0 1 / 1 0
# expect-out: menú 1
# expect-out: fin

const ID_SALIR = 1
const ID_ICONOS = 21
const ID_LISTA = 22
const ID_NOMBRE = 30
const ID_FECHA = 31

@header "#include <devices/input.h>"
@header "#include <dos/dostags.h>"
@header "static struct Window *teclas_win; static struct Task *teclas_padre;"


@native func donde(win: Int)
"""
    struct Window *w = NULL;
    GetAttr(MUIA_Window_Window, (Object *)win, (ULONG *)&w);
    teclas_win = w;
"""
end

@native func proceso_teclas()
"""
    struct MsgPort *port = CreateMsgPort();
    struct IOStdReq *io = port ? (struct IOStdReq *)CreateIORequest(port, sizeof(struct IOStdReq)) : NULL;
    static const UWORD codigos[4] = { 0x28, 0x36, 0x28, 0x10 };   /* L, N, L, Q */
    Delay(50);
    if (teclas_win && io && OpenDevice((CONST_STRPTR)"input.device", 0, (struct IORequest *)io, 0) == 0) {
        struct InputEvent ie;
        LONG i;
        ActivateWindow(teclas_win);
        Delay(10);
        io->io_Command = IND_WRITEEVENT;
        io->io_Data = &ie;
        io->io_Length = sizeof(ie);
        for (i = 0; i < 4; i++) {
            memset(&ie, 0, sizeof(ie));
            ie.ie_Class = IECLASS_RAWKEY;
            ie.ie_Code = 0x67;                  /* right Amiga, as a keyboard sends it */
            ie.ie_Qualifier = IEQUALIFIER_RCOMMAND;
            DoIO((struct IORequest *)io);
            Delay(2);
            ie.ie_Code = codigos[i];
            DoIO((struct IORequest *)io);
            Delay(2);
            ie.ie_Code = codigos[i] | IECODE_UP_PREFIX;
            DoIO((struct IORequest *)io);
            Delay(2);
            ie.ie_Code = 0x67 | IECODE_UP_PREFIX;
            ie.ie_Qualifier = 0;
            DoIO((struct IORequest *)io);
            Delay(25);
        }
        CloseDevice((struct IORequest *)io);
    }
    if (io) DeleteIORequest((struct IORequest *)io);
    if (port) DeleteMsgPort(port);
    Forbid();                       /* the program may only end once this process has gone */
    Signal(teclas_padre, SIGBREAKF_CTRL_F);
"""
end

@native func lanzar()
"""
    teclas_padre = FindTask(NULL);
    SetSignal(0, SIGBREAKF_CTRL_F);
    if (CreateNewProcTags(NP_Entry, (ULONG)proceso_teclas, NP_Name, (ULONG)"dash_teclas", TAG_DONE) == NULL)
        teclas_padre = NULL;
"""
end

@native func esperar_teclas()
"""
    if (teclas_padre) Wait(SIGBREAKF_CTRL_F);
"""
end

Main
    if mui_app_begin("Opciones", "DASHMENURADIO") == 0
        Print "sin MUI"
    else
        win = mui_window_begin("Opciones", 0)
            mui_menu_begin("Ver")
                iconos = mui_menu_radio("Iconos", "I", ID_ICONOS, true)
                lista = mui_menu_radio("Lista", "L", ID_LISTA, false)
                mui_menu_separator()
                mui_submenu_begin("Ordenar")
                    nombre = mui_menu_radio("Nombre", "N", ID_NOMBRE, false)
                    fecha = mui_menu_radio("Fecha", "F", ID_FECHA, true)
                mui_submenu_end()
                mui_menu_separator()
                mui_menu_item("Salir", "Q", ID_SALIR)
            mui_menu_end()
            mui_text("Menú con opciones")
        mui_window_end()
        Print "al empezar: #{mui_get_value(iconos)} #{mui_get_value(lista)} / #{mui_get_value(nombre)} #{mui_get_value(fecha)}"
        mui_set_value(lista, 1)
        mui_set_value(nombre, 1)
        Print "poner: #{mui_get_value(iconos)} #{mui_get_value(lista)} / #{mui_get_value(nombre)} #{mui_get_value(fecha)}"
        mui_set_value(iconos, 1)
        mui_set_value(fecha, 1)
        mui_window_open(win)
        donde(win)
        lanzar()
        ev = 0
        while ev != ID_SALIR and ev != -1
            ev = mui_wait_event()
            if ev == ID_SALIR or ev == -1
                Print "menú #{ev}"
            else
                Print "menú #{ev}: #{mui_get_value(iconos)} #{mui_get_value(lista)} / #{mui_get_value(nombre)} #{mui_get_value(fecha)}"
            end
        end
        mui_app_end()
        esperar_teclas()
        Print "fin"
    end
end
