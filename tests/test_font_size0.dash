# Test: font_open with a size below 1 asks for 1 (D57): diskfont 47 of AmigaOS 3.2 with bullet
# writes into memory that is not its own when it opens an outline font at size 0.
# expect-c: if (size < 1) size = 1;
# expect-out: true true

Main
    a = font_open("topaz.font", 0)
    b = font_open("topaz.font", -5)
    Print "" + (a != 0) + " " + (b != 0)
end
