# Test: common exit path
# A window that cannot open (also inside a function) exits through
# _dash_exit(), which closes windows, screen, pool and libraries
#
# expect-c: if (!win_Ventana) _dash_exit(20);
# expect-c: static void _dash_exit_cleanup(void) {
# expect-c: if (win_Ventana) { if (_dash_win == win_Ventana) _dash_win = NULL; _dash_before_close(win_Ventana); CloseWindow(win_Ventana); win_Ventana = NULL; }

Window Ventana
    title "Salida"
    width 200
    height 100
end

func abrir()
    Ventana.open
end

Main
    nombre = "x" + "y"
    abrir()
    EventLoop
        On Close
            Stop
        end
    end
end
