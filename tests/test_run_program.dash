# run_program and program_relaunch (Trasfondo 0.7, updating itself). run_program starts a command line without
# waiting. The test runs itself with "padre": that copy takes single_instance, asks program_relaunch and ends;
# its relaunch (the same arguments) finds single_instance free (the first one let its port go before) and
# says so in a file the test waits for.
# expect-out: run_program: true hola
# expect-out: relanzado: true
# expect-out: fin

@native func escribir(path: String, text: String)
"""
    BPTR f = Open((CONST_STRPTR)path, MODE_NEWFILE);
    if (f) { Write(f, text, strlen((char *)text)); Close(f); }
"""
end

# up to 10 s for a file: its first line, or "" if it never came
@native func esperar(path: String) -> String
"""
    char b[64];
    LONG i, n;
    BPTR f;
    b[0] = 0;
    for (i = 0; i < 500; i++) {
        if ((f = Open((CONST_STRPTR)path, MODE_OLDFILE))) {
            n = Read(f, b, sizeof(b) - 1);
            Close(f);
            if (n > 0) { b[n] = 0; while (n > 0 && (b[n - 1] == '\n' || b[n - 1] == ' ')) b[--n] = 0; break; }
        }
        Delay(2);
    }
    return _dash_str_dup((STRPTR)b, TRUE);
"""
end

@native func existe(path: String) -> Bool
"""
    BPTR l = Lock((CONST_STRPTR)path, ACCESS_READ);
    if (l) UnLock(l);
    return l != 0;
"""
end

# this program, as a command line
@native func yo() -> String
"""
    char path[300], name[120];
    if (!NameFromLock(GetProgramDir(), (STRPTR)path, sizeof(path)) || !GetProgramName((STRPTR)name, sizeof(name)))
        return _dash_str_dup((STRPTR)"", TRUE);
    AddPart((STRPTR)path, FilePart((CONST_STRPTR)name), sizeof(path));
    return _dash_str_dup((STRPTR)path, TRUE);
"""
end

Main
    if arg(0) == "padre"
        libre = single_instance("DashRelanzar")
        if existe("RAM:relanzar.flag")
            # the relaunched copy
            escribir("RAM:relanzado.txt", "#{libre}\n")
        else
            escribir("RAM:relanzar.flag", "1")
            program_relaunch()
            time_delay(10)
        end
    else
        ok = run_program("Echo >RAM:rp.txt hola")
        t = esperar("RAM:rp.txt")
        Print "run_program: #{ok} " + t
        y = yo()
        run_program("\"" + y + "\" padre")
        r = esperar("RAM:relanzado.txt")
        Print "relanzado: " + r
        Print "fin"
    end
end
