# Test: desktop_canvas (Trasfondo): drawing on the Workbench's background, behind its icons. The
# canvas lies over the disk icons (top left of the 3.2 Workbench, in backdrop mode). After each
# update every pixel of the area is the drawing's, except the icons', which do not change; a window
# over it and away again repaints it (the hook, and the Workbench the icons, clearing their boxes
# with its wallpaper: the next update draws the canvas there again); at the end the area is as it was.
# workbench
# expect-out: lienzo: true
# expect-out: hay iconos debajo: true
# expect-out: primera vez bien: true
# expect-out: segunda vez bien: true
# expect-out: solo lo que cambia: true
# expect-out: tras tapar y destapar: true
# expect-out: como estaba: true
# expect-out: fin

@c
"""
#define _T_W 200
#define _T_H 60
static UBYTE _t_antes[_T_W * _T_H];      /* the screen before the canvas */
static UBYTE _t_fondo[_T_W * _T_H];      /* the wallpaper there (the canvas's front bitmap at first) */
static LONG _t_raya = 20;                 /* where the drawing's stripe is */
static struct Screen *_t_scr;             /* the runtime's, kept: after desktop_canvas_free it has none */
static LONG _t_x0, _t_y0;                 /* the area on the screen */

static LONG _t_pantalla(LONG x, LONG y)   /* a pixel of the area on the screen */
{
    return ReadPixel(&_t_scr->RastPort, _t_x0 + x, _t_y0 + y);
}

static LONG _t_dibujo(LONG x, LONG y)     /* what the drawing has there */
{
    return x >= _t_raya && x < _t_raya + 10 ? 3 : (y < 30 ? 2 : 1);
}
"""
end

@native func guardar(c: Int) -> Int
"""
    struct _DashDesk *d = (struct _DashDesk *)c;
    struct RastPort r;
    LONG x, y, n = 0;
    _t_scr = LockPubScreen((CONST_STRPTR)"Workbench");     /* until the end */
    _t_x0 = _dash_desk_win->LeftEdge + 4;
    _t_y0 = _dash_desk_win->TopEdge + 4;
    InitRastPort(&r);
    r.BitMap = d->wall;
    for (y = 0; y < _T_H; y++)
        for (x = 0; x < _T_W; x++) {
            _t_antes[y * _T_W + x] = _t_pantalla(x, y);
            _t_fondo[y * _T_W + x] = ReadPixel(&r, x, y);
            if (_t_antes[y * _T_W + x] != _t_fondo[y * _T_W + x]) n++;
        }
    return n;
"""
end

# píxeles mal: de icono que cambiaron, o del dibujo que no son el dibujo
@native func mal() -> Int
"""
    LONG x, y, n = 0;
    for (y = 0; y < _T_H; y++)
        for (x = 0; x < _T_W; x++) {
            LONG i = y * _T_W + x, v = _t_pantalla(x, y);
            if (_t_antes[i] != _t_fondo[i] ? v != _t_antes[i] : v != _t_dibujo(x, y)) {
                if (n < 6) Printf((CONST_STRPTR)"  %ld,%ld: %ld (antes %ld, fondo %ld, dibujo %ld)\n", x, y, v,
                                  (LONG)_t_antes[i], (LONG)_t_fondo[i], _t_dibujo(x, y));
                n++;
            }
        }
    if (n) Printf((CONST_STRPTR)"  %ld mal\n", n);
    return n;
"""
end

# píxeles distintos de como estaba la pantalla al empezar
@native func distintos() -> Int
"""
    LONG x, y, n = 0;
    for (y = 0; y < _T_H; y++)
        for (x = 0; x < _T_W; x++)
            if (_t_pantalla(x, y) != _t_antes[y * _T_W + x]) n++;
    return n;
"""
end

@native func mover_raya(x: Int) -> Int
"""
    _t_raya = x;
    return 0;
"""
end

@native func rect_ultima() -> Int
"""
    return (LONG)_dash_desk_rects_last;
"""
end

# una ventana encima del lienzo, y fuera
@native func tapar() -> Int
"""
    struct Window *v = OpenWindowTags(NULL, WA_PubScreenName, (ULONG)"Workbench",
        WA_Left, _t_x0 + 16, WA_Top, _t_y0 + 6,
        WA_Width, 120, WA_Height, 40, WA_Activate, FALSE, TAG_DONE);
    if (!v) return 0;
    Delay(10);
    CloseWindow(v);
    return 1;
"""
end

@native func raya() -> Int
"""
    return _t_raya;
"""
end

func pintar(x, y, w, h)
    gfx_pen(2)
    gfx_rect(0, 0, w - 1, 29)
    gfx_pen(1)
    gfx_rect(0, 30, w - 1, h - 1)
    r = raya()
    gfx_pen(3)
    gfx_rect(r, 0, r + 9, h - 1)
end

Main
    # el Workbench abre su ventana de fondo un poco después de arrancar
    c = desktop_canvas(4, 4, 200, 60)
    intentos = 0
    while c == 0 and intentos < 100
        time_delay(5)
        c = desktop_canvas(4, 4, 200, 60)
        intentos = intentos + 1
    end
    Print "lienzo: #{c != 0}"
    if c != 0
        Print "hay iconos debajo: #{guardar(c) > 50}"
        desktop_canvas_on_draw(c, pintar)
        desktop_canvas_update(c)
        Print "primera vez bien: #{mal() == 0}"
        mover_raya(60)
        desktop_canvas_update(c)
        Print "segunda vez bien: #{mal() == 0}"
        # (las primeras miran también lo que el gancho repintó al arrancar el Workbench)
        for i in (1..4)
            desktop_canvas_update(c)
        end
        Print "solo lo que cambia: #{rect_ultima() == 0}"
        tapar()
        time_delay(50)
        desktop_canvas_update(c)
        Print "tras tapar y destapar: #{mal() == 0}"
        desktop_canvas_free(c)
        time_delay(50)
        Print "como estaba: #{distintos() == 0}"
    end
    Print "fin"
end
