# The clock and dates (Trasfondo 0.7): clock_read and its parts worked out from the DateStamp (fixed days:
# the first one, a 29 February, a century; and now, the same as locale.library's FormatDate gives),
# date_text with FormatDate in the system's language (English in the emulator) and, without
# locale.library, in English by Dash itself; @version puts $VER: in the program (C:Version) and
# program_version gives it.
# memcheck
# expect-c: _dash_ver[] = "$VER: " "Prueba 1.2" " (
# expect-out: 1978-1-1 0 00:00:00 Sunday 01-Jan-78
# expect-out: 2024-2-29 4 13:05:07 Thursday 29-Feb-24
# expect-out: 2000-3-1 3 23:59:59 Wednesday 01-Mar-00
# expect-out: 2099-12-31 4 12:00:00 Thursday 31-Dec-99
# expect-out: ahora como FormatDate: true
# expect-out: nombres como FormatDate: true
# expect-out: versión: Prueba 1.2
# expect-out: $VER en el programa: true
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

@version "Prueba 1.2"

# a fixed day and time through the same code (and the English formatting without locale.library)
@native func dia(days: Int, minute: Int, tick: Int) -> String
"""
    struct DateStamp ds;
    struct _DashDateOut o;
    LONG c[7];
    char b[300];
    ds.ds_Days = days; ds.ds_Minute = minute; ds.ds_Tick = tick;
    _dash_date_split(&ds, c);
    o.n = 0;
    _dash_date_plain(&o, "%A %d-%b-%y", c);
    o.buf[o.n] = 0;
    sprintf(b, "%ld-%ld-%ld %ld %02ld:%02ld:%02ld %s", c[0], c[1], c[2], c[3], c[4], c[5], c[6], o.buf);
    return _dash_str_dup((STRPTR)b, TRUE);
"""
end

@native func plano_ahora(f: String) -> String
"""
    struct DateStamp ds;
    struct _DashDateOut o;
    LONG c[7];
    DateStamp(&ds);
    _dash_date_split(&ds, c);
    o.n = 0;
    _dash_date_plain(&o, (const char *)f, c);
    o.buf[o.n] = 0;
    return _dash_str_dup((STRPTR)o.buf, TRUE);
"""
end

# the program's own file has $VER: and the version
@native func ver_en_fichero() -> Bool
"""
    char name[256], b[4096];
    BPTR f;
    LONG n, i;
    BOOL ok = FALSE;
    strcpy(name, "PROGDIR:");
    if (!GetProgramName((STRPTR)name + 8, sizeof(name) - 8)) return FALSE;
    memmove(name + 8, FilePart((CONST_STRPTR)name + 8), strlen((char *)FilePart((CONST_STRPTR)name + 8)) + 1);
    if (!(f = Open((CONST_STRPTR)name, MODE_OLDFILE))) return FALSE;
    while (!ok && (n = Read(f, b, sizeof(b))) > 0)
        for (i = 0; i + 16 < n && !ok; i++)
            if (!memcmp(b + i, "$VER: Prueba 1.2", 16)) ok = TRUE;
    Close(f);
    return ok;
"""
end

func dos(n: Int) -> String
    if n < 10
        return "0#{n}"
    end
    return "#{n}"
end

Main
    Print dia(0, 0, 0)
    Print dia(16860, 13 * 60 + 5, 7 * 50)
    Print dia(8095, 23 * 60 + 59, 59 * 50 + 49)
    Print dia(44559, 12 * 60, 0)
    ok = false
    for i in (1..3)
        clock_read()
        mio = "#{clock_year()}-" + dos(clock_month()) + "-" + dos(clock_day()) + " #{clock_weekday()} " + dos(clock_hour()) + ":" + dos(clock_minute())
        suyo = date_text("%Y-%m-%d %w %H:%M")
        if mio == suyo
            ok = true
            break
        end
        Print mio + " / " + suyo
    end
    Print "ahora como FormatDate: #{ok}"
    a = date_text("%A %B")
    b = plano_ahora("%A %B")
    Print "nombres como FormatDate: #{a == b}"
    v = program_version()
    Print "versión: " + v
    Print "$VER en el programa: #{ver_en_fichero()}"
end
