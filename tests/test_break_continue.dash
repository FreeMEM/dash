# Test: break and continue
# Inside while, for-range and for-each; break leaves only the innermost loop
#
# expect-out: 1
# expect-out: 3
# expect-out: 5
# expect-out: 10
# expect-out: 20
# expect-out: 1-1
# expect-out: 2-1
# expect-out: 3
# expect-out: 7

func primero_mayor(lista, limite)
    for v in lista
        if v > limite
            return v
        end
    end
    return 0
end

Main
    for i in (1..10)
        if i % 2 == 0
            continue
        end
        if i > 5
            break
        end
        Print i
    end

    nums = [10, 20, 30, 40]
    for n in nums
        if n == 30
            break
        end
        Print n
    end

    for a in (1..2)
        for b in (1..3)
            if b == 2
                break
            end
            Print "#{a}-#{b}"
        end
    end

    k = 0
    while true
        k = k + 1
        if k < 3
            continue
        end
        break
    end
    Print k
    Print primero_mayor([1, 5, 7, 9], 6)
end
