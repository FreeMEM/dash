# Test: @native functions
# Their declared return type is used by callers, and inline C that
# calls graphics.library makes the program open it.
#
# expect-c: _dash_str_set(&s, saludo());
# expect-c: Printf("%s\n", s);
# expect-c: GfxBase = (struct GfxBase *)OpenLibrary("graphics.library"
#
# expect-out: hola

@native func saludo() -> String
"""
    return (STRPTR)"hola";
"""
end

@native func espera_vblank()
"""
    WaitTOF();
"""
end

Main
    s = saludo()
    Print s
    espera_vblank()
end
