# Test: gl_* without minigl.library (the systems of the other machines do not have it; the A500 and the A1200 have no
# FPU either): gl_open gives false and every other gl_* does nothing, without hanging or crashing.
# expect-out: gl_open: false
# expect-out: pantalla: false
# expect-out: píxel: -1 error: 0 tecla: 0 cerrada: false textura: 0
# expect-out: fin
import "lib/amiga/gl.dash"

Main
    Print "gl_open: #{gl_open(64, 48)}"
    Print "pantalla: #{gl_open_screen(320, 240)}"
    gl_enable(GL_DEPTH_TEST)
    gl_clear_color(0.5, 0.5, 0.5)
    gl_clear()
    gl_matrix_mode(GL_PROJECTION)
    gl_perspective(60, 1.3, 1, 100)
    gl_ortho(-1, 1, -1, 1, -1, 1)
    gl_look_at(0, 0, 5, 0, 0, 0, 0, 1, 0)
    gl_begin(GL_TRIANGLES)
    gl_color(1, 0, 0)
    gl_vertex(0, 1, 0)
    gl_end()
    gl_light(0, 0, 0, 1)
    gl_fog(1, 10, 0.5, 0.5, 0.5)
    gl_texture_bind(3)
    gl_swap()
    Print "píxel: #{gl_read_pixel(1, 1)} error: #{gl_error()} tecla: #{gl_key()} cerrada: #{gl_closed()} textura: #{gl_texture(0)}"
    gl_close()
    Print "fin"
end
