# Test: a String field passed to a function (dashweb D22). If no code sets that field,
# it goes without a copy (it lives as long as its object); if some code sets it, the
# callee could free it, so it goes as a copy. Copies and slices of long texts use the
# length cache.
#
# expect-c: #define _DASH_LEND_Fijo_texto(p) (p)
# expect-c: #define _DASH_LEND_Cambia_texto(p) _dash_str_ret(p)
# expect-c: largo(f, _DASH_LEND_Fijo_texto(
# expect-c: cambiar(c, _DASH_LEND_Cambia_texto(
# expect-no-c: LONG len = s ? strlen(s) : 0;
# expect-c: if (d) _dash_str_setlen(d, len);
# memcheck
# expect-out: 70 o
# expect-out: [uno] dos
# expect-out: 70
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

struct Fijo
    texto: String
end

struct Cambia
    texto: String
end

func largo(f: Fijo, s: String) -> String
    return "" + s.length + " " + s[69:70]
end

func cambiar(c: Cambia, s: String) -> String
    c.texto = "dos"          # frees the old text: s must be a copy
    return "[" + s + "] " + c.texto
end

Main
    t = ""
    for i in (1..7)
        t = t + "abcdefghi" + i
    end
    t = t[:69] + "o"
    f = Fijo(t)
    Print largo(f, f.texto)
    c = Cambia("uno")
    Print cambiar(c, c.texto)
    copia = f.texto
    Print copia.length
end
