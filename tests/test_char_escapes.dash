# Test: a character compared with an escaped one-character literal ("\n", "\r", "\t",
# "\\", "\"") compares the character (it used to compare pointers and never matched)
# expect-c: == '\r')
# expect-out: n r t b q
# expect-out: 5

Main
    s = "a\nb\rc\td\\e\"f"
    r = ""
    for i in (0..s.length - 1)
        c = s[i]
        if c == "\n"
            r = r + "n "
        elif c == "\r"
            r = r + "r "
        elif c == "\t"
            r = r + "t "
        elif c == "\\"
            r = r + "b "
        elif c == "\""
            r = r + "q"
        end
    end
    Print r
    n = 0
    for c in s
        if c != "\n" and c != "\r" and c != "\t" and c != "\\" and c != "\""
            n = n + 1
        end
    end
    Print n - 1
end
