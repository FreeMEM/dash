# expect-c: STRPTR nombre_fijo(void)
# expect-c: void eco(LONG s) {
# expect-c: Printf("%ld\n", s);
# expect-c: _dash_str_cmp(nombre_fijo(), "Ana") == 0
# expect-c: _dash_str_cmp(msg, "otro") != 0
# expect-c: _dash_str_set_join(&total, 2, (STRPTR[]){"Total: ", DashString_from_int(n)});
# expect-c: _dash_str_set_join(&cuenta, 2, (STRPTR[]){DashString_from_int(n), " items"});
# expect-c: LONG x = (!(a == b));
# expect-c: Printf("100%% hecho\n");
#
# expect-out: Hola Dash!
# expect-out: igual
# expect-out: distinto
# expect-out: Total: 5
# expect-out: 5 items
# expect-out: Valor 5
# expect-out: true
# expect-out: 100% hecho
# expect-out: 7

func saluda(nombre: String) -> String
    return "Hola " + nombre + "!"
end

func nombre_fijo()
    return "Ana"
end

func eco(s)
    Print s
end

Main
    msg = saluda("Dash")
    Print msg

    if nombre_fijo() == "Ana"
        Print "igual"
    end
    if msg != "otro"
        Print "distinto"
    end

    n = 5
    total = "Total: " + n
    Print total
    cuenta = n + " items"
    Print cuenta
    Print "Valor #{n}"

    a = 1
    b = 2
    x = not a == b
    Print x

    Print "100% hecho"
    eco(7)
end
