# Questions to a SANA-II driver with any TCP/IP stack, with a driver of the test's own ("dashfake.device", in
# DEVS:Networks/): net_drivers_read finds it only while something (here, the test as its stack) has it open,
# and nothing asks a driver that nobody uses (it would start its hardware). wifi_read_device: unit 0 answers
# -55 and -92 dBm, unit 1 does not have the command, unit 4 is offline, unit 5 is the stack's only, unit 3
# never answers but gives the request back on AbortIO, unit 2 never answers and keeps it even then (what
# hangs NewMeter). Nothing waits longer than its time; a request kept by a driver is not asked again until
# it comes back (other units are), and is freed then. The driver stays open between questions (ten of them
# open it no more), until its stack lets it go: then it is closed and not in use (3). net_driver_read gives its
# packets. At the end, a request still kept stays out there with its port
# ignoring the reply.
# expect-out: sin usar: 3 3 encontrado: false
# expect-out: en uso: encontrado: true
# expect-out: señal: 0 -55 -92
# expect-out: paquetes: 0 1234 567
# expect-out: sin la orden: 2
# expect-out: desconectado: 4
# expect-out: solo de su pila: 5
# expect-out: no contesta y aborta: 1 a tiempo: true guardada: false
# expect-out: no contesta ni aborta: 1 a tiempo: true
# expect-out: mientras la tiene: 1 al momento: true, otra unidad: 0 abortos: 2
# expect-out: devuelta: 0 -55
# expect-out: abierto: 4
# expect-out: diez preguntas, aperturas: 0
# expect-out: la pila lo suelta: 3 abierto: 0
# expect-out: al acabar, guardada: true
# expect-out: fin

@header "static struct Device *otros[20]; static LONG otros_n;"
@header "static struct Device *fake_dev; static struct IORequest *fake_kept; static LONG fake_aborts, fake_opens; static struct IORequest *pila;"

# a SANA-II driver of the test's own: "dashfake.device"
@c
"""
static LONG fake_open(struct IORequest *io __asm("a1"), ULONG unit __asm("d0"), ULONG flags __asm("d1"),
                      struct Device *dev __asm("a6")) {
    if (unit == 5) { io->io_Error = IOERR_UNITBUSY; return IOERR_UNITBUSY; }
    dev->dd_Library.lib_OpenCnt++;
    fake_opens++;
    io->io_Device = dev;
    io->io_Unit = (struct Unit *)unit;
    io->io_Error = 0;
    return 0;
}
static BPTR fake_close(struct IORequest *io __asm("a1"), struct Device *dev __asm("a6")) {
    dev->dd_Library.lib_OpenCnt--;
    io->io_Device = (struct Device *)-1;
    return 0;
}
static ULONG fake_null(void) { return 0; }
static void fake_beginio(struct IORequest *io __asm("a1"), struct Device *dev __asm("a6")) {
    struct IOSana2Req *s2 = (struct IOSana2Req *)io;
    ULONG unit = (ULONG)io->io_Unit;
    io->io_Message.mn_Node.ln_Type = NT_MESSAGE;
    io->io_Flags &= ~IOF_QUICK;
    io->io_Error = 0;
    if (io->io_Command == S2_GETGLOBALSTATS && unit == 0) {
        ((struct Sana2DeviceStats *)s2->ios2_StatData)->PacketsReceived = 1234;
        ((struct Sana2DeviceStats *)s2->ios2_StatData)->PacketsSent = 567;
    } else if (io->io_Command != S2_GETSIGNALQUALITY || unit == 1) io->io_Error = IOERR_NOCMD;
    else if (unit == 4) io->io_Error = 10;         /* S2ERR_OUTOFSERVICE */
    else if (unit == 0) {
        ((struct Sana2SignalQuality *)s2->ios2_StatData)->SignalLevel = -55;
        ((struct Sana2SignalQuality *)s2->ios2_StatData)->NoiseLevel = -92;
    } else { fake_kept = io; return; }            /* units 2 and 3: kept */
    ReplyMsg(&io->io_Message);
}
static void fake_abortio(struct IORequest *io __asm("a1"), struct Device *dev __asm("a6")) {
    fake_aborts++;
    if (fake_kept == io && (ULONG)io->io_Unit == 3) {
        fake_kept = NULL;
        io->io_Error = IOERR_ABORTED;
        ReplyMsg(&io->io_Message);
    }
}
"""
end

@native func fake_poner() -> Bool
"""
    static APTR vec[7];
    vec[0] = (APTR)fake_open; vec[1] = (APTR)fake_close; vec[2] = (APTR)fake_null; vec[3] = (APTR)fake_null;
    vec[4] = (APTR)fake_beginio; vec[5] = (APTR)fake_abortio; vec[6] = (APTR)-1;
    fake_dev = (struct Device *)MakeLibrary((APTR)vec, NULL, NULL, sizeof(struct Device), 0);
    if (!fake_dev) return FALSE;
    fake_dev->dd_Library.lib_Node.ln_Type = NT_DEVICE;
    fake_dev->dd_Library.lib_Node.ln_Name = (char *)"dashfake.device";
    Forbid();
    AddTail(&SysBase->DeviceList, &fake_dev->dd_Library.lib_Node);   /* (after the others) */
    Permit();
    return TRUE;
"""
end

# 20 other devices open before it in exec's list (Ferrán's Amiga had 16 before wifipi.device: they were
# all the search looked at)
@native func otros_dispositivos() -> Bool
"""
    static APTR vec[7];
    static char names[20][16];
    LONG i;
    otros_n = 0;
    vec[0] = (APTR)fake_open; vec[1] = (APTR)fake_close; vec[2] = (APTR)fake_null; vec[3] = (APTR)fake_null;
    vec[4] = (APTR)fake_beginio; vec[5] = (APTR)fake_abortio; vec[6] = (APTR)-1;
    for (i = 0; i < 20; i++) {
        struct Device *d = (struct Device *)MakeLibrary((APTR)vec, NULL, NULL, sizeof(struct Device), 0);
        if (!d) return FALSE;
        sprintf(names[i], "otro%ld.device", i);
        d->dd_Library.lib_Node.ln_Type = NT_DEVICE;
        d->dd_Library.lib_Node.ln_Name = names[i];
        d->dd_Library.lib_OpenCnt = 1;
        otros[otros_n++] = d;
        Forbid();
        AddTail(&SysBase->DeviceList, &d->dd_Library.lib_Node);
        Permit();
    }
    return TRUE;
"""
end

# it is a network driver: a file of its name in DEVS:Networks/
@native func marcar_red() -> Bool
"""
    BPTR l = CreateDir((CONST_STRPTR)"DEVS:Networks");
    if (l) UnLock(l);
    if (!(l = Open((CONST_STRPTR)"DEVS:Networks/dashfake.device", MODE_NEWFILE))) return FALSE;
    Close(l);
    return TRUE;
"""
end

# the test as its stack: the driver open while it runs
@native func pila_abrir() -> Bool
"""
    struct MsgPort *p = CreateMsgPort();
    if (p) pila = CreateIORequest(p, sizeof(struct IOSana2Req));
    return pila && OpenDevice((CONST_STRPTR)"dashfake.device", 0, pila, 0) == 0;
"""
end

func encontrado() -> Bool
    n = net_drivers_read()
    for i in (0..n - 1)
        if net_driver_name(i) == "dashfake.device"
            return true
        end
    end
    return false
end

func preguntar(unidad: Int, ms: Int) -> Int
    return wifi_read_device("dashfake.device", unidad, ms)
end

@native func guardada() -> Bool
"""
    return fake_kept != NULL;
"""
end

@native func abortos() -> Int
"""
    return fake_aborts;
"""
end

@native func aperturas() -> Int
"""
    return fake_opens;
"""
end

# the stack lets the driver go
@native func pila_cerrar()
"""
    CloseDevice(pila);
"""
end

@native func abierto() -> Int
"""
    return fake_dev->dd_Library.lib_OpenCnt;
"""
end

# the driver gives back the request it kept
@native func devolver()
"""
    struct IORequest *io = fake_kept;
    fake_kept = NULL;
    if (io) { io->io_Error = IOERR_ABORTED; ReplyMsg(&io->io_Message); }
"""
end

# what the program's end does; then the driver gives the request back (to a port that ignores it) and goes
@native func acabar() -> Bool
"""
    BOOL kept = fake_kept != NULL;
    _dash_meter_cleanup();
    devolver();
    CloseDevice(pila);
    Forbid();
    Remove(&fake_dev->dd_Library.lib_Node);
    while (otros_n > 0) Remove(&otros[--otros_n]->dd_Library.lib_Node);
    Permit();
    return kept;
"""
end

Main
    otros_dispositivos()
    fake_poner()
    marcar_red()
    a = preguntar(0, 500)
    b = net_driver_read("DEVS:Networks/dashfake.device", 0, 500)
    Print "sin usar: #{a} #{b} encontrado: #{encontrado()}"
    pila_abrir()
    Print "en uso: encontrado: #{encontrado()}"
    r = preguntar(0, 500)
    Print "señal: #{r} #{wifi_signal()} #{wifi_noise()}"
    r = net_driver_read("dashfake.device", 0, 500)
    Print "paquetes: #{r} #{net_driver_packets_in()} #{net_driver_packets_out()}"
    r = preguntar(1, 500)
    Print "sin la orden: #{r}"
    r = preguntar(4, 500)
    Print "desconectado: #{r}"
    r = preguntar(5, 500)
    Print "solo de su pila: #{r}"
    t = time_ms()
    r = preguntar(3, 300)
    t = time_ms() - t
    Print "no contesta y aborta: #{r} a tiempo: #{t >= 250 and t < 700} guardada: #{guardada()}"
    t = time_ms()
    r = preguntar(2, 300)
    t = time_ms() - t
    Print "no contesta ni aborta: #{r} a tiempo: #{t >= 450 and t < 900}"
    t = time_ms()
    r = preguntar(2, 300)
    t = time_ms() - t
    r0 = preguntar(0, 500)
    Print "mientras la tiene: #{r} al momento: #{t < 100}, otra unidad: #{r0} abortos: #{abortos()}"
    devolver()
    r = preguntar(0, 500)
    Print "devuelta: #{r} #{wifi_signal()}"
    Print "abierto: #{abierto()}"
    antes = aperturas()
    for i in (1..10)
        preguntar(0, 500)
    end
    Print "diez preguntas, aperturas: #{aperturas() - antes}"
    pila_cerrar()
    r = preguntar(0, 500)
    Print "la pila lo suelta: #{r} abierto: #{abierto()}"
    pila_abrir()
    preguntar(2, 100)
    Print "al acabar, guardada: #{acabar()}"
    Print "fin"
end
