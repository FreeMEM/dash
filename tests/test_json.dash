# Test: lib/json.dash (Dash 2.0, for Inferencia): reading JSON into a tree, its values, paths, escapes and \uXXXX as
# UTF-8, errors, and writing the tree back, compact and pretty.
# expect-out: modelo: [gpt-x] 3 true
# expect-out: texto: [Hola "mundo"\n] 13
# expect-out: unicode: [c3a9 e282ac f09f9880] true
# expect-out: números: -12 3 2500 [1.5e3] true
# expect-out: nulos: true true false
# expect-out: lista: 4 [b] 7
# expect-out: escrito: {"a":[1,true,null,"x\"y\\z\n\u0001"],"b":{},"c":[]}
# expect-out: vuelta: true
# expect-out: {
# expect-out: .."model":."m",
# expect-out: .."messages":.[
# expect-out: ....{
# expect-out: ......"role":."user",
# expect-out: ......"content":."hola"
# expect-out: ....}
# expect-out: ..],
# expect-out: .."stream":.false
# expect-out: }
# expect-out: error 1: [nil] [',' or '}' was expected at byte 8]
# expect-out: error 2: [unexpected end at byte 1]
# expect-out: error 3: [something after the end at byte 2]
# expect-out: error 4: [a string without its end at byte 5]
# expect-out: error 5: [bad \u escape at byte 3]
# expect-out: cambios: {"x":2,"z":"tres"} 2 false
# expect-out: real: 2 [0.5]

import "lib/json.dash"

func hex(s: String) -> String
    out = ""
    for i in (0..s.length - 1)
        h = str_from_int(str_code(s, i), 16)
        if h.length < 2
            h = "0" + h
        end
        out = out + h
    end
    return out
end

Main
    t = "{ \"id\": \"gen-1\", \"model\": \"gpt-x\", \"choices\": [ {\"index\": 0, \"message\": {\"role\": \"assistant\", \"content\": \"Hola \\\"mundo\\\"\\n\"}} ], \"usage\": {\"total_tokens\": 3}, \"ok\": true }"
    j = json_parse(t)
    mo = json_get_str(j, "model")
    tk = json_path_int(j, "usage.total_tokens")
    ok = json_get_bool(j, "ok")
    Print "modelo: [#{mo}] #{tk} #{ok}"
    c = json_path_str(j, "choices.0.message.content")
    cv = str_replace(c, "\n", "\\n")
    Print "texto: [#{cv}] #{c.length}"

    u = json_parse("[\"\\u00e9\", \"\\u20AC\", \"\\ud83d\\ude00\"]")
    Print "unicode: [#{hex(json_str(json_at(u, 0)))} #{hex(json_str(json_at(u, 1)))} #{hex(json_str(json_at(u, 2)))}] #{json_length(u) == 3}"

    n = json_parse("[-12, 3.75, 2.5e3, 1.5e3, 0]")
    f = json_float(json_at(n, 1))
    Print "números: #{json_num(json_at(n, 0))} #{json_num(json_at(n, 1))} #{json_num(json_at(n, 2))} [#{json_at(n, 3).text}] #{f > 3.7 and f < 3.8}"

    z = json_parse("{\"a\": null}")
    n1 = json_is_null(json_get(z, "a"))
    n2 = json_has(z, "a")
    n3 = json_has(z, "b")
    Print "nulos: #{n1} #{n2} #{n3}"

    l = json_parse("  [1, \"b\", [], {\"x\": 7}]  ")
    lx = json_path_int(l, "3.x")
    Print "lista: #{json_length(l)} [#{json_str(json_at(l, 1))}] #{lx}"

    o = json_object()
    a = json_array()
    json_push(a, json_int(1))
    json_push(a, json_bool(true))
    json_push(a, json_null())
    json_push(a, json_string("x\"y\\z\n" + str_char(1)))
    json_set(o, "a", a)
    json_set(o, "b", json_object())
    json_set(o, "c", json_array())
    w = json_write(o)
    Print "escrito: #{w}"
    Print "vuelta: #{json_write(json_parse(w)) == w}"

    p = json_object()
    json_set_str(p, "model", "m")
    ms = json_array()
    m = json_object()
    json_set_str(m, "role", "user")
    json_set_str(m, "content", "hola")
    json_push(ms, m)
    json_set(p, "messages", ms)
    json_set_bool(p, "stream", false)
    Print str_replace(json_pretty(p), " ", ".")

    e = json_parse("{\"a\": 1 \"b\": 2}")
    if e == nil
        Print "error 1: [nil] [#{json_error()}]"
    end
    e = json_parse("[")
    Print "error 2: [#{json_error()}]"
    e = json_parse("1 2")
    Print "error 3: [#{json_error()}]"
    e = json_parse("\"hola")
    Print "error 4: [#{json_error()}]"
    e = json_parse("\"\\u12x4\"")
    Print "error 5: [#{json_error()}]"

    k = json_object()
    json_set_int(k, "x", 1)
    json_set_int(k, "y", 5)
    json_set_str(k, "z", "tres")
    json_set_int(k, "x", 2)
    b = json_remove(k, "y")
    b2 = json_remove(k, "y")
    Print "cambios: #{json_write(k)} #{json_length(k)} #{b2}"

    r = json_real(0.5)
    r2 = json_num(json_number("2.9"))
    Print "real: #{r2} [#{r.text}]"
end
