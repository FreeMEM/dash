# Colours in a .dashui (Dash 2.0, Forja's dark theme): "background" on the window and a text, "color" on a text and a
# button become mui_set_background and mui_set_text_pen.
# emu-needs: muimaster.library
# expect-c: mui_set_background(
# emu-shot: 10 300 150 000000
# expect-out: texto: [Texto claro]
# expect-out: fin

import "lib/ventana_colores.dashui"

Main
    if mui_app_begin("Colores", "DASHUICOLORES") == 0
        Print "sin MUI"
    else
        v = Oscura_create()
        mui_window_open(v.window)
        Print "texto: [#{mui_get_text(v.texto)}]"
        mui_timer(12000, 1)
        ev = mui_wait_event()
        mui_app_end()
        Print "fin"
    end
end
