# Pasting in GadTools text fields (Ferrán García, TrasfondoPrefs): Intuition's string gadgets do not, and wrote a "v".
# Right Amiga, left Amiga and Ctrl with V paste the clipboard at the cursor (its first line; in a number field, its
# digits only), with C copy the whole text and with X cut it. The program started again as "teclas" types them.
# expect-out: Amiga derecha + V: [a41.38b]
# expect-out: Amiga izquierda + V: [41.38]
# expect-out: Ctrl + V: [41.38]
# expect-out: números: [12]
# expect-out: Ctrl + C: [copiado] [copiado]
# expect-out: Amiga izquierda + X: [] [cortado]
# expect-out: fin

# a key with left Amiga, which input_key does not have (its 8 is right Amiga)
@native func amiga_izq(code: Int)
"""
    _dash_input_raw(0x66, IEQUALIFIER_LCOMMAND);
    _dash_input_raw((UWORD)code, IEQUALIFIER_LCOMMAND);
    _dash_input_raw((UWORD)code | IECODE_UP_PREFIX, IEQUALIFIER_LCOMMAND);
    _dash_input_raw(0x66 | IECODE_UP_PREFIX, 0);
"""
end

func esperar_ventana()
    t = 0
    while input_active_title() != "Pegar" and t < 200
        time_delay(5)
        t = t + 1
    end
    time_delay(20)
end

# a click on the field (from the window's corner), the keys, and Return
func en_campo(y: Int, paso: String)
    input_click(150, y, 0)
    time_delay(10)
    if paso == "derecha"
        input_text("a")
        input_key(0x34, 8)
        input_text("b")
    elif paso == "izquierda"
        amiga_izq(0x34)
    elif paso == "ctrl"
        input_key(0x34, 2)
    elif paso == "copiar"
        input_key(0x33, 2)
    elif paso == "cortar"
        amiga_izq(0x32)
    end
    time_delay(10)
    input_key(0x44, 0)
end

func probar(s: Int, y: Int, paso: String, texto: String) -> String
    gt_set_text(s, texto)
    h = run_start("\"" + program_path() + "\" " + paso + " #{y}", 30000)
    vueltas = 0
    while vueltas < 400
        e = gt_event()
        if e == s
            vueltas = 1000
        end
        time_delay(2)
        vueltas = vueltas + 1
    end
    r = run_finish(h)
    return "[" + gt_get_string(s) + "]"
end

Main
    if arg(0) != ""
        esperar_ventana()
        en_campo(Int(arg(1)), arg(0))
    else
        ok = clip_write_text("41.38\nsegunda línea")
        window_create("Pegar", 20, 20, 320, 90, 0)
        gt_init()
        s = gt_string(60, 30, 200, 14, "Lat", "", 40)
        n = gt_integer(60, 50, 200, 14, "Num", 0)
        gt_attach()
        Print "Amiga derecha + V: " + probar(s, 48, "derecha", "")
        Print "Amiga izquierda + V: " + probar(s, 48, "izquierda", "")
        Print "Ctrl + V: " + probar(s, 48, "ctrl", "")
        ok = clip_write_text("1x2 grados")
        h = run_start("\"" + program_path() + "\" ctrl 68", 30000)
        vueltas = 0
        while vueltas < 400
            if gt_event() == n
                vueltas = 1000
            end
            time_delay(2)
            vueltas = vueltas + 1
        end
        r = run_finish(h)
        Print "números: [#{gt_get_value(n)}]"
        c = probar(s, 48, "copiar", "copiado")
        Print "Ctrl + C: " + c + " [" + clip_read_text() + "]"
        c = probar(s, 48, "cortar", "cortado")
        Print "Amiga izquierda + X: " + c + " [" + clip_read_text() + "]"
        gt_cleanup()
        Print "fin"
    end
end
