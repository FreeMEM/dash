# A read-only DOS handler for the tests (test_handler_bloques): mounted with Device= (a FileSysStartupMsg), it reads
# the blocks of its partition with dev_read. The volume "Bloques" has two files: "primero" (the first block of the
# partition) and "ultimo" (the last one), 512 bytes each. The disk of the runner (# emu-hardfile) starts each block i
# with "BLOQ" and i in four digits. Writing gives ERROR_WRITE_PROTECTED: ERROR_DISK_WRITE_PROTECTED would make the
# DOS of the client open a requester ("Volume Bloques is write protected"), and the test would wait.
import "lib/amiga/handler.dash"

var dev: Int = 0
var first: Int = 0
var count: Int = 0
var bsize: Int = 512
var volume: Int = 0
var pos: [Int] = [0, 0, 0]    # where each open file is (index 1: primero, 2: ultimo)

func key_of(name: String) -> Int
    s = name
    c = str_find(s, ":")
    if c >= 0
        s = s[c + 1:]
    end
    s = str_lower(s)
    if s == ""
        return 0
    elif s == "primero"
        return 1
    elif s == "ultimo"
        return 2
    end
    return -1
end

func block_of(key: Int) -> Int
    if key == 1
        return first
    end
    return first + count - 1
end

func fill(fib: Int, key: Int)
    if key == 0
        fib_fill(fib, 0, ST_ROOT, "Bloques", 0, 0, 0, "")
    elif key == 1
        fib_fill(fib, 1, ST_FILE, "primero", bsize, 0, 0, "")
    else
        fib_fill(fib, 2, ST_FILE, "ultimo", bsize, 0, 0, "")
    end
end

Main
    handler_log("T:#{handler_name()}.log")
    dev = fssm_open()
    first = fssm_first_block()
    count = fssm_blocks()
    bsize = fssm_block_size()
    Print "#{handler_name()}: #{fssm_device()} unidad #{fssm_unit()}, bloques #{first} a #{first + count - 1} de #{bsize}"
    if dev == 0
        handler_ready(false, ERROR_NO_DISK)
        program_exit(20)
    end
    buf = buffer_alloc(bsize)
    e = dev_read(dev, first, bsize, buf, bsize)
    Print "primer bloque: error #{e}, #{str_from_buffer(buf, 0, 8)}"
    volume = handler_volume_add("Bloques", ID_DOS_DISK)
    handler_ready(true, 0)
    while true
        p = handler_wait()
        if p == 0
            break
        end
        pk = Ptr DosPacket(p)
        t = pk.dp_Type
        r1 = DOSFALSE
        r2 = 0
        if t == ACTION_LOCATE_OBJECT
            key = key_of(bstr_text(pk.dp_Arg2))
            if lock_key(pk.dp_Arg1) != 0 and key != 0
                key = -1
            end
            if lock_key(pk.dp_Arg1) != 0 and key == 0
                key = lock_key(pk.dp_Arg1)
            end
            if key < 0
                r2 = ERROR_OBJECT_NOT_FOUND
            elif pk.dp_Arg3 == EXCLUSIVE_LOCK and key != 0
                r2 = ERROR_WRITE_PROTECTED
            else
                r1 = lock_new(key, SHARED_LOCK, volume)
            end
        elif t == ACTION_FREE_LOCK
            lock_free(pk.dp_Arg1)
            r1 = DOSTRUE
        elif t == ACTION_COPY_DIR
            r1 = lock_new(lock_key(pk.dp_Arg1), SHARED_LOCK, volume)
        elif t == ACTION_PARENT
            if lock_key(pk.dp_Arg1) != 0
                r1 = lock_new(0, SHARED_LOCK, volume)
            end
        elif t == ACTION_EXAMINE_OBJECT
            fill(baddr(pk.dp_Arg2), lock_key(pk.dp_Arg1))
            r1 = DOSTRUE
        elif t == ACTION_EXAMINE_NEXT
            fib = baddr(pk.dp_Arg2)
            n = Ptr FileInfoBlock(fib).fib_DiskKey
            if lock_key(pk.dp_Arg1) != 0 or n >= 2
                r2 = ERROR_NO_MORE_ENTRIES
            else
                fill(fib, n + 1)
                r1 = DOSTRUE
            end
        elif t == ACTION_FINDINPUT
            key = key_of(bstr_text(pk.dp_Arg3))
            if key <= 0
                r2 = ERROR_OBJECT_NOT_FOUND
            else
                pos[key] = 0
                h = Ptr FileHandle(baddr(pk.dp_Arg1))
                h.fh_Args = key
                h.fh_Port = 0
                r1 = DOSTRUE
            end
        elif t == ACTION_FINDOUTPUT or t == ACTION_FINDUPDATE or t == ACTION_DELETE_OBJECT or t == ACTION_RENAME_OBJECT
            r2 = ERROR_WRITE_PROTECTED
        elif t == ACTION_READ
            key = pk.dp_Arg1
            n = bsize - pos[key]
            if n > pk.dp_Arg3
                n = pk.dp_Arg3
            end
            if n > 0
                e = dev_read(dev, block_of(key), bsize, buf, bsize)
                if e != 0
                    n = -1
                    r2 = ERROR_NOT_A_DOS_DISK
                else
                    buffer_copy(pk.dp_Arg2, 0, buf, pos[key], n)
                    pos[key] = pos[key] + n
                end
            end
            r1 = n
        elif t == ACTION_SEEK
            key = pk.dp_Arg1
            np = pk.dp_Arg2
            if pk.dp_Arg3 == OFFSET_CURRENT
                np = pos[key] + pk.dp_Arg2
            elif pk.dp_Arg3 == OFFSET_END
                np = bsize + pk.dp_Arg2
            end
            if np < 0 or np > bsize
                r1 = -1
                r2 = ERROR_SEEK_ERROR
            else
                r1 = pos[key]
                pos[key] = np
            end
        elif t == ACTION_EXAMINE_FH
            fill(baddr(pk.dp_Arg2), pk.dp_Arg1)
            r1 = DOSTRUE
        elif t == ACTION_END
            r1 = DOSTRUE
        elif t == ACTION_DISK_INFO
            info_fill(baddr(pk.dp_Arg1), count, count, bsize, ID_WRITE_PROTECTED, volume)
            r1 = DOSTRUE
        elif t == ACTION_INFO
            info_fill(baddr(pk.dp_Arg2), count, count, bsize, ID_WRITE_PROTECTED, volume)
            r1 = DOSTRUE
        elif t == ACTION_IS_FILESYSTEM
            r1 = DOSTRUE
        elif t == ACTION_CURRENT_VOLUME
            r1 = mkbptr(volume)
        elif t == ACTION_DIE
            packet_reply(p, DOSTRUE, 0)
            break
        else
            r2 = ERROR_ACTION_NOT_KNOWN
        end
        packet_reply(p, r1, r2)
    end
    handler_volume_remove(volume)
end
