# Menus of a window in DashOS (S10, dashos_menus_v1 of kit-c): a check, options (a group of radio items), a
# submenu with its own group, and their marks with mui_get_value / mui_set_value. In qemu there is no compositor:
# the window is built (kit-c keeps its menus as data) and never opened, so there is no mui_app_begin.
# expect-out: casilla: 1 0
# expect-out: opciones: 0 1 0
# expect-out: marcar la tercera: 0 0 1
# expect-out: desmarcar: 0 0 0
# expect-out: submenú: 1 0
# expect-out: otro grupo: 0 1 / 1 0 0
# expect-out: título: Ordenar por
# expect-out: fin

Main
    win = mui_window_begin("Menús", 0)
        mui_menu_begin("Ver")
            barra = mui_menu_check("Barra de estado", "B", 20, true)
            mui_menu_separator()
            iconos = mui_menu_radio("Iconos", "1", 21, false)
            lista = mui_menu_radio("Lista", "2", 22, true)
            columnas = mui_menu_radio("Columnas", "3", 23, false)
            mui_menu_separator()
            orden = mui_submenu_begin("Ordenar")
                nombre = mui_menu_radio("Nombre", "", 30, true)
                fecha = mui_menu_radio("Fecha", "", 31, false)
            mui_submenu_end()
        mui_menu_end()
        mui_text("Menús")
    mui_window_end()
    a = mui_get_value(barra)
    mui_set_value(barra, 0)
    Print "casilla: #{a} #{mui_get_value(barra)}"
    Print "opciones: #{mui_get_value(iconos)} #{mui_get_value(lista)} #{mui_get_value(columnas)}"
    mui_set_value(columnas, 1)
    Print "marcar la tercera: #{mui_get_value(iconos)} #{mui_get_value(lista)} #{mui_get_value(columnas)}"
    mui_set_value(columnas, 0)
    Print "desmarcar: #{mui_get_value(iconos)} #{mui_get_value(lista)} #{mui_get_value(columnas)}"
    Print "submenú: #{mui_get_value(nombre)} #{mui_get_value(fecha)}"
    mui_set_value(fecha, 1)
    mui_set_value(iconos, 1)
    Print "otro grupo: #{mui_get_value(nombre)} #{mui_get_value(fecha)} / #{mui_get_value(iconos)} #{mui_get_value(lista)} #{mui_get_value(columnas)}"
    mui_set_text(orden, "Ordenar por")
    Print "título: #{mui_get_text(orden)}"
    Print "fin"
end
