# Test: windows by handle, Win.close and the current directory
# window_create returns a handle (1..16); handle 0 is the current window.
# Windows still open are closed at exit; the starting directory is restored.
#
# expect-c: static void _dash_windows_cleanup(void)
# expect-c: if (w < 40) w = 40;
# expect-c: if (win_Principal) { _dash_windows_forget(win_Principal); _dash_before_close(win_Principal); CloseWindow(win_Principal); win_Principal = NULL; }
# expect-out: 1
# expect-out: 2
# expect-out: 0
# expect-out: 3
# expect-out: Disk:
# expect-out: ok
# expect-out: cerrada

Window Principal
    title "Principal"
    width 200
    height 80
end

Main
    Principal.open
    a = window_create("Uno", 10, 20, 200, 100, 0)
    b = window_create("Dos " + a, 40, 60, 200, 100, 1)
    Print a
    Print b
    window_move(a, 100, 30)
    window_resize(b, 300, 150)
    window_title(a, "Uno movida")
    window_to_back(a)
    window_to_front(a)
    window_activate(b)
    Wait 1
    window_close(a)
    window_close(a)
    window_move(99, 0, 0)
    window_title(-1, "nada")
    Print window_create("Mini", 0, 0, 0, 0, 0) - 1
    c = window_create("Otra", 5, 5, 100, 60, 2)
    Print c
    if dir_change("RAM:")
        Print dir_current()[4:]     # "Ram Disk:" in 3.1, "RAM Disk:" in 3.2
    end
    if not dir_change("RAM:no_existe")
        Print "ok"
    end
    Principal.close
    Principal.close
    Print "cerrada"
end
