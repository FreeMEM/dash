# desktop_canvas_veil: the wallpaper below the drawing mixed with a colour once, not on every update (Trasfondo's
# veil was half its time in RTG); mixed again where the desktop repaints with another wallpaper, and gone with
# alpha 0. desktop_canvas_drawing: in the drawing function, whether a part of the canvas is being drawn.
# (RTG: 68040 with uaegfx, 16 bits)
# workbench
# rtg
# expect-out: fondo: true
# expect-out: con velo: true
# expect-out: dibuja la derecha: true
# expect-out: velo sobre el fondo nuevo: true
# expect-out: update_area sin la derecha: false
# expect-out: sin velo: true
# expect-out: fin

import "lib/escritorio_fondo.dash"

var dentro: Bool = false

# the canvas (at 10, 10 of the window) is darker than the desktop's fill there: black at alpha 128 (planar:
# some pixel of a 4x4 block of the dither is not the fill's pen)
@native func velado() -> Bool
"""
    LONG x0 = _f_win->LeftEdge + 10 + 60, y0 = _f_win->TopEdge + 10 + 12, x, y;
    ULONG fuera = _f_px(_f_win->LeftEdge + 300, _f_win->TopEdge + 100), dentro;
    WaitBlit();
    if (!_f_planar) {
        dentro = _f_px(x0, y0);
        return ((dentro >> 16) & 255) < ((fuera >> 16) & 255);
    }
    for (y = 0; y < 4; y++) for (x = 0; x < 4; x++) if (_f_px(x0 + x, y0 + y) != fuera) return TRUE;
    return FALSE;
"""
end

func pintar_velo(x: Int, y: Int, w: Int, h: Int)
    dentro = desktop_canvas_drawing(50, 0, 10, h)
    gfx_pen(1)
    gfx_rect(0, 0, 9, h - 1)
end

Main
    Print "fondo: #{abrir_fondo()}"
    c = desktop_canvas(10, 10, 100, 30)
    desktop_canvas_on_draw(c, pintar_velo)
    desktop_canvas_veil(c, 0x000000, 128)
    desktop_canvas_update(c)
    Print "con velo: #{velado()}"
    Print "dibuja la derecha: #{dentro}"
    cambiar_fondo(3)
    desktop_canvas_update_area(c, 0, 0, 20, 30)
    Print "velo sobre el fondo nuevo: #{velado()}"
    desktop_canvas_update_area(c, 0, 0, 20, 30)
    Print "update_area sin la derecha: #{dentro}"
    desktop_canvas_veil(c, 0, 0)
    desktop_canvas_update(c)
    Print "sin velo: #{fondo_debajo()}"
    desktop_canvas_free(c)
    cerrar_fondo()
    Print "fin"
end
