# Test: TLS sessions resumed (dashweb D55). After a connection to a server has read (TLS 1.3 sends the
# session then) or closed, the next connection to the same host and port resumes its session and skips
# the key exchange: tls_resumed says so. Another name is another server: no session to resume.
# emu-net-tls: 40871
# emu-needs: amisslmaster.library
# memcheck
# expect-out: primera: nueva, eco: uno
# expect-out: segunda: reanudada, eco: dos
# expect-out: tercera: reanudada, eco: tres
# expect-out: localhost: nueva, eco: cuatro
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

func probar(nombre: String, host: String, texto: String)
    s = net_connect("127.0.0.1", 40871, 5000)
    t = tls_connect(s, host)
    if t < 0
        Print nombre + ": fallo " + net_error()
    else
        estado = "nueva"
        if tls_resumed(t)
            estado = "reanudada"
        end
        tls_send(t, texto + "\n")
        r = tls_recv(t, 100, 5000)
        Print nombre + ": " + estado + ", " + str_trim(r)
        tls_close(t)
    end
    net_close(s)
end

Main
    probar("primera", "127.0.0.1", "uno")
    probar("segunda", "127.0.0.1", "dos")
    probar("tercera", "127.0.0.1", "tres")
    probar("localhost", "localhost", "cuatro")
end
