# Test: fonts (font_open of the ROM's topaz 8, a font that does not exist, size, height,
# baseline, width, styles) and color_pen (the same RGB gives the same cached pen)
# memcheck
# expect-out: topaz: 1 8
# expect-out: alto 8 base 6 ancho 32 32
# expect-out: negrita 2
# expect-out: subrayada y cursiva 5
# expect-out: normal 0
# expect-out: no existe: 0
# expect-out: mismo pen: 1 1
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

@native func estilo_actual() -> Int
"""
    return _dash_rp ? (LONG)_dash_rp->AlgoStyle : -1;
"""
end

Window W
    title "Fuentes"
    width 320
    height 120
end

Main
    W.open
    f = font_open("topaz.font", 8)
    Print "topaz: " + (f != 0) + " " + font_size(f)
    font_use(f)
    Print "alto " + font_height() + " base " + font_baseline() + " ancho " + font_text_width("Hola") + " " + gfx_text_len("Hola")
    font_style(2)
    Print "negrita " + estilo_actual()
    font_style(1 + 4)
    Print "subrayada y cursiva " + estilo_actual()
    font_style(0)
    Print "normal " + estilo_actual()
    Print "no existe: " + font_open("no-existe.font", 13)
    rojo = color_pen(255, 0, 0)
    Print "mismo pen: " + (rojo == color_pen(255, 0, 0)) + " " + (rojo >= 0)
    gfx_pen(rojo)
    gfx_text_at(10, 20, "rojo")
    font_close(f)
    W.close
end
