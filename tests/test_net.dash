# Test: TCP over bsdsocket.library (FS-UAE's, the PC's network). The runner starts an
# echo server on 127.0.0.1:40831 of the PC that answers one line with "eco: <line>".
# emu-net: 40831
# memcheck
# expect-out: 127.0.0.1
# expect-out: conectado
# expect-out: enviados 10
# expect-out: eco: hola red
# expect-out: cerrada
# expect-out: rechazada: conexión rechazada
# expect-out: nil
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

Main
    Print net_resolve("127.0.0.1")
    s = net_connect("127.0.0.1", 40831, 5000)
    if s >= 0
        Print "conectado"
    end
    Print "enviados " + net_send(s, "hola red\r\n")
    respuesta = ""
    trozo = net_recv(s, 4, 5000)
    while trozo != nil
        respuesta = respuesta + trozo
        trozo = net_recv(s, 4, 5000)
    end
    Print str_trim(respuesta)
    Print "cerrada"
    net_close(s)
    r = net_connect("127.0.0.1", 1, 3000)
    if r < 0
        Print "rechazada: " + net_error()
    end
    if net_resolve("no.existe.invalid") == nil
        Print "nil"
    end
end
