# Test: arrays and strings in expressions
# Array literals outside plain assignment keep their values (constant ones
# are static tables: no stack copy),
# string arrays, char concatenation, pooled memory freed at exit
#
# expect-c: [3] = {10, 20, 30};
# expect-c: _dash_obj_set((void **)&nums, DashArray_from(3, _dash_arrlit_
# expect-c: _dash_r = DashArray_from(3, _dash_arrlit_
# expect-c: Printf("%ld\n", suma((LONG)DashArray_from(2, _dash_arrlit_
# expect-c: _dash_obj_set((void **)&nombres, DashArray_from(2, (LONG[]){(LONG)"Ana", (LONG)"Bea"}));
# expect-c: Printf("%s\n", (STRPTR)DashArray_get(nombres, 1));
# expect-c: STRPTR n = (STRPTR)DashArray_get(nombres, _idx_n);
# expect-c: DashString_from_char(DashString_char_at(palabra, 0))
# expect-c: _dash_mem_cleanup();
#
# expect-out: 20
# expect-out: 3
# expect-out: 9
# expect-out: Bea
# expect-out: Ana
# expect-out: Bea
# expect-out: Letra: H

func lista()
    return [1, 2, 3]
end

func suma(a)
    total = 0
    for v in a
        total = total + v
    end
    return total
end

Main
    nums = [10, 20, 30]
    Print nums[1]
    l = lista()
    Print l[2]
    Print suma([4, 5])

    nombres = ["Ana", "Bea"]
    Print nombres[1]
    for n in nombres
        Print n
    end

    palabra = "Hola"
    inicial = "Letra: " + palabra[0]
    Print inicial
end
