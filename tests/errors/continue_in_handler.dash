# Test: continue inside an EventLoop handler is an error, even inside a loop
# (in C the handler is a switch case)
# expect: continue can only be used inside a while or for loop

Window W
    title "x"
    width 100
    height 50
end

Main
    W.open
    for i in (1..3)
        EventLoop
            On Close
                continue
            end
        end
    end
end
