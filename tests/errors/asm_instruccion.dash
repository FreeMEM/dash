# Test: una instrucción que no existe en un bloque asm, con su línea
# expect: asm_instruccion.dash:9:9: Error: asm: instrucción desconocida: movx
# expect-dash: asm_instruccion.dash:9:9: Error: asm: instrucción desconocida: movx
Main
    x = 1
    asm in d0 = x out x = d0
        addq.l  #1,d0
        ; un comentario
        movx.l  d0,d1
    end
    Print x
end
