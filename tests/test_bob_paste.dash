# Test: bob_paste draws a frame of a BOB with its mask (colour 0 lets what is under it show) and saves nothing: a
# second paste somewhere else leaves the first one. Frames out of range wrap around.
#
# expect-c: static void _dash_bob_paste(LONG id, LONG frame, LONG x, LONG y)
# expect-out: fotograma 1: 3 1
# expect-out: el primero sigue: 3
# expect-out: fotograma 2 es el 0: 2
# expect-out: fin

Window W
    title "Pegar"
    width 200
    height 100
end

Main
    W.open
    # dos fotogramas de 16: el 0 todo del lápiz 2; el 1, la mitad izquierda del 3 y la derecha transparente
    bob_create(0, 32, 16, 2)
    bitmap_draw_to(0)
    gfx_pen(2)
    gfx_rect(0, 0, 15, 15)
    gfx_pen(3)
    gfx_rect(16, 0, 23, 15)
    gfx_pen(0)
    gfx_rect(24, 0, 31, 15)
    bitmap_draw_screen()
    gfx_pen(1)
    gfx_rect(0, 0, 150, 60)
    bob_paste(0, 1, 10, 10)
    Print "fotograma 1: #{gfx_pixel_read(12, 12)} #{gfx_pixel_read(22, 12)}"
    bob_paste(0, 1, 60, 10)
    Print "el primero sigue: #{gfx_pixel_read(12, 12)}"
    bob_paste(0, 2, 100, 10)
    Print "fotograma 2 es el 0: #{gfx_pixel_read(105, 15)}"
    bob_free(0)
    Print "fin"
end
