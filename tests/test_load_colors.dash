# Test: bob_load_colors puts the CMAP of a picture in the screen's palette (from colour first on) and says how many;
# sprite_load_colors gives a sprite colours 1-3 of a picture (here only that it runs: the sprite colours 17-31 cannot
# be read back on the emulator's 16-colour native screen, see test_sprite_rgb8). A file that is not IFF gives 0 and
# false.
#
# expect-c: static LONG _dash_bob_load_colors(STRPTR file, LONG first)
# expect-out: colores: 4
# expect-out: color 1: true
# expect-out: color 3 desde 8, en el 11: true
# expect-out: sprite: true
# expect-out: no IFF: 0 false

func escribir(ruta: String, bytes: [Int])
    f = file_open(ruta, 1006)
    for b in bytes
        file_write_byte(f, b)
    end
    file_close(f)
end

func color(p: Int) -> Int
    gfx_pen(p)
    gfx_pixel(5, 5)
    return gfx_pixel_rgb(5, 5)
end

Main
    # FORM ILBM con un BMHD de 16 x 1 y 2 planos, y un CMAP de 4 colores (multiplos de 17: exactos en ECS)
    var iff: [Int] = [70, 79, 82, 77, 0, 0, 0, 52, 73, 76, 66, 77,
                      66, 77, 72, 68, 0, 0, 0, 20, 0, 16, 0, 1, 0, 0, 0, 0, 2, 0, 0, 0, 0, 0, 10, 11, 0, 16, 0, 1,
                      67, 77, 65, 80, 0, 0, 0, 12, 0, 0, 0, 204, 17, 34, 51, 85, 119, 238, 221, 0]
    escribir("RAM:dash_cmap.iff", iff)
    file_write_text("RAM:dash_no.iff", "no es un IFF")
    cmap = "RAM:dash_cmap.iff"
    no = "RAM:dash_no.iff"
    if screen_open(4, "Colores")
        Print "colores: #{bob_load_colors(cmap, 0)}"
        Print "color 1: #{color(1) == 0xCC1122}"
        bob_load_colors(cmap, 8)
        Print "color 3 desde 8, en el 11: #{color(11) == 0xEEDD00}"
        sprite_create(0, 16, 8)
        Print "sprite: #{sprite_load_colors(0, cmap)}"
        sprite_free(0)
        Print "no IFF: #{bob_load_colors(no, 0)} #{sprite_load_colors(0, no)}"
        screen_close()
    end
end
